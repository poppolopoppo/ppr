// Notes:
// This code snippet is cut and pasted from a larger codebase. Note that
// this code has lines like:
//     CS_ResolveUpsampleMsaa2.m_sceneUpsample[dispatchThreadId.xy*2 + int2(0,0)] = float4(dst00,1);
//
// That is because the larger codebase uses a preprocessor macro to expand out
// "CS_ResolveUpsampleMsaa2.m_sceneUpsample" into a autogenerated texture name, so you'll have to
// modify that for your own engine.


float CalcLuminance(float3 color)
{
	return dot(color,float3(.25f,.5f,.25f));
}


float3 CalcDiamondAvg(float3 left, float3 right, float3 up, float3 down)
{
	return 0.25f * (left + right + up + down);
}

float3 CalcDiamondAbsDiff(float3 left, float3 right, float3 up, float3 down)
{
	float lumL = CalcLuminance(left);
	float lumR = CalcLuminance(right);
	float lumU = CalcLuminance(up);
	float lumD = CalcLuminance(down);
	
	float diffH = abs(lumL - lumR);
	float diffV = abs(lumU - lumD);
	
	float3 avgH = (left + right) * .5f;
	float3 avgV = (up + down) * .5f;
	
	float3 ret = (diffH < diffV) ? avgH : avgV;
	
	return ret;
}


//#define MSAA2_USE_LINEAR
#define MSAA2_USE_SMALLEST_ABSOLUTE_DIFFERENCE

[numthreads(8, 8, 1)]
void CS_ResolveUpsampleMsaa2(
	uint3 groupId : SV_GroupID,
	uint3 groupThreadId : SV_GroupThreadID,
	uint3 dispatchThreadId : SV_DispatchThreadID,
	uint groupIndex : SV_GroupIndex)
{

	Texture2DMS<float4, 2> texData = CS_ResolveUpsampleMsaa2.m_sceneMsaa2x;

	int2 srcXy = dispatchThreadId.xy;
	
	int sizeX = s_rangeCb.m_rangeSize.x;
	int sizeY = s_rangeCb.m_rangeSize.y;
	
	
	int halfX0 = max(0,srcXy.x-1);
	int halfX1 = srcXy.x;
	int halfX2 = min(sizeX-1,srcXy.x+1);
	
	int halfY0 = max(0,srcXy.y-1);
	int halfY1 = srcXy.y;
	int halfY2 = min(sizeY-1,srcXy.y+1);
	
	if (dispatchThreadId.x < s_rangeCb.m_rangeSize.x &&
		dispatchThreadId.y < s_rangeCb.m_rangeSize.y)
	{
		
		
	//  
	//  1  .
	//  .  0
	//
	
	//      0     2     4
	//                  
	// 0    1  .  1  .  1  .    0
	//      .  0  .  0  .  0   
	// 2    1  .  1  .  1  .    2
	//      .  0  .  0  .  0
	// 4    1  .  1  .  1  .    4
	//      .  0  .  0  .  0
	//                  
	//      0     2     4
		
		float3 color13 = texData.Load(int2(halfX1,halfY0),0).xyz;
		float3 color22 = texData.Load(int2(halfX1,halfY1),1).xyz;
		float3 color24 = texData.Load(int2(halfX2,halfY1),1).xyz;
		float3 color31 = texData.Load(int2(halfX0,halfY1),0).xyz;
		float3 color33 = texData.Load(int2(halfX1,halfY1),0).xyz;
		float3 color42 = texData.Load(int2(halfX1,halfY2),1).xyz;
		
		float3 dst00 = color22;
		float3 dst11 = color33;
		
		float3 dst01 = 0;
		float3 dst10 = 0;

		#ifdef MSAA2_USE_LINEAR
		dst01 = CalcDiamondAvg(color22,color24,color13,color33);
		dst10 = CalcDiamondAvg(color31,color33,color22,color42);
		#endif
		
		#ifdef MSAA2_USE_SMALLEST_ABSOLUTE_DIFFERENCE
		dst01 = CalcDiamondAbsDiff(color22,color24,color13,color33);
		dst10 = CalcDiamondAbsDiff(color31,color33,color22,color42);
		#endif
		
		CS_ResolveUpsampleMsaa2.m_sceneUpsample[dispatchThreadId.xy*2 + int2(0,0)] = float4(dst00,1);
		CS_ResolveUpsampleMsaa2.m_sceneUpsample[dispatchThreadId.xy*2 + int2(1,0)] = float4(dst01,1);
		CS_ResolveUpsampleMsaa2.m_sceneUpsample[dispatchThreadId.xy*2 + int2(0,1)] = float4(dst10,1);
		CS_ResolveUpsampleMsaa2.m_sceneUpsample[dispatchThreadId.xy*2 + int2(1,1)] = float4(dst11,1);
	
	}
}



{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "preset": "openai",
  "companion": {
    "enabled": true,
    "position": "bottom-right",
    "size": "medium",
    "gifPack": "default",
    "loopStyle": "smooth",
    "speed": 1,
    "debug": false
  },
  "presets": {
    "openai": {
      "orchestrator": {
        "model": "openai/gpt-6-sol",
        "variant": "high",
        "skills": [
          "*"
        ],
        "mcps": [
          "*",
          "!context7"
        ]
      },
      "oracle": {
        "model": "openai/gpt-6-astra",
        "variant": "high",
        "skills": [
          "clion-tools",
          "simplify",
          "code-reviewer",
          "concurrency-patterns",
          "memory-allocator",
          "hal-developer"
        ],
        "mcps": [
          "clion",
          "codegraph",
          "windbg-ttd"
        ]
      },
      "librarian": {
        "model": "openai/gpt-6-luna",
        "variant": "low",
        "skills": [],
        "mcps": [
          "context7",
          "gh_grep",
          "codegraph",
          "searxng",
          "windbg-ttd"
        ]
      },
      "explorer": {
        "model": "openai/gpt-6-luna",
        "variant": "low",
        "skills": [
          "clion-tools",
          "git-log-fast-navigation"
        ],
        "mcps": [
          "clion",
          "codegraph"
        ]
      },
      "designer": {
        "model": "openai/gpt-6-luna",
        "temperature": 0.3,
        "variant": "medium",
        "skills": [
          "plantuml-skill"
        ],
        "mcps": [
          "codegraph"
        ]
      },
      "fixer": {
        "model": "openai/gpt-6-terra",
        "variant": "high",
        "skills": [
          "build-system",
          "clion-tools",
          "module-architect",
          "unit-test-updater",
          "validation",
          "git-commit-planner",
          "git-push-planner",
          "concurrency-patterns",
          "memory-allocator",
          "hal-developer",
          "plantuml-skill",
          "windbg-triage"
        ],
        "mcps": [
          "clion",
          "codegraph",
          "searxng",
          "windbg-ttd"
        ]
      },
      "observer": {
        "model": "openai/gpt-5.3-codex-spark",
        "temperature": 0.3,
        "skills": [],
        "mcps": [],
        "variant": "low"
      },
      "council": {
        "model": "openai/gpt-6-astra",
        "variant": "max",
        "skills": [
          "*"
        ],
        "mcps": [
          "*",
          "!context7"
        ]
      }
    },
    "opencode-zen-free": {
  "orchestrator": {
    "model": "opencode/nemotron-3-ultra-free",
    "temperature": 0.4,
    "variant": "high",  // Changed from "xhigh" for stability
    "skills": ["*"],
    "mcps": ["*", "!context7"]
  },
  "oracle": {
    "model": "opencode/muse-spark-1.3-contributor-free",
    "temperature": 0.4,   // Kept at 0.4 for review tasks
    "variant": "high",    // Changed from "xhigh"
    "skills": [
      "clion-tools", "simplify", "code-reviewer",
      "concurrency-patterns", "memory-allocator", "hal-developer"
    ],
    "mcps": ["clion", "codegraph", "windbg-ttd"]
  },
  "explorer": {
    "model": "opencode/space-bunny-free",
    "temperature": 0.2,   // Excellent for deterministic search
    "variant": "high",    // Kept as is
    "skills": ["clion-tools", "git-log-fast-navigation"],
    "mcps": ["clion", "codegraph"]
  },
  "librarian": {
    "model": "opencode/ling-3.0-flash-fin-free", // Recommended model
    "temperature": 0.7,   // Changed from 0.2 to align with model's needs
    "variant": "high",
    "skills": [],
    "mcps": ["context7", "gh_grep", "codegraph", "searxng", "windbg-ttd"]
  },
  "designer": {
    "model": "opencode/mimo-v2.6-flash-free",
    "temperature": 0.6,   // Changed from 0.3; model performs better higher
    "skills": ["plantuml-skill"],
    "mcps": ["codegraph"]
  },
  "fixer": {
    "model": "opencode/muse-spark-1.3-contributor-free",
    "temperature": 0.2,   // Kept at 0.2 for deterministic code output
    "skills": [
      "build-system", "clion-tools", "module-architect",
      "unit-test-updater", "concurrency-patterns", "memory-allocator",
      "hal-developer", "plantuml-skill", "windbg-triage"
    ],
    "mcps": ["clion", "codegraph", "pix-mcp", "searxng", "windbg-ttd"]
  },
  "observer": {
    "model": "opencode/nemotron-3.5-lightning-free", // Recommended model
    "temperature": 0.2,   // Matches NVIDIA's instruct mode recommendation
    "skills": [],
    "mcps": []
  },
  "council": {
    "model": "opencode/nemotron-3-ultra-free",
    "temperature": 0.4,
    "variant": "high",    // Changed from "xhigh"
    "skills": ["*"],
    "mcps": ["*", "!context7"]
  }
},
  "council": {
    "default_preset": "diverse",
    "timeout": 180000,
    "councillor_execution_mode": "parallel",
    "councillor_retries": 3,
    "presets": {
      "diverse": {
        "alpha": {
          "model": "opencode/muse-spark-1.3-contributor-free",
          "variant": "xhigh",
          "prompt": "Focus on architectural soundness, module partition design, and long-term maintainability for C++23 engine code."
        },
        "beta": {
          "model": "opencode/space-bunny-free",
          "variant": "high",
          "prompt": "Focus on performance, allocator composition throughput, RawChannel MPSC concurrency, and hot-path efficiency."
        },
        "gamma": {
          "model": "opencode/mimo-v2.6-flash-free",
          "prompt": "Focus on correctness, edge cases, unit test coverage, and failure modes in engine subsystems."
        },
        "delta": {
          "model": "opencode/nemotron-3-ultra-free",
          "prompt": "Focus on C++23 idioms, import std patterns, constexpr optimization, safe_ptr lifetime, and PPR coding standards."
        }
      },
      "fast": {
        "alpha": {
          "model": "opencode/space-bunny-free",
          "variant": "high"
        },
        "beta": {
          "model": "opencode/muse-spark-1.3-contributor-free",
          "variant": "medium"
        }
      }
    }
  }
}

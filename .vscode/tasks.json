{
    "tasks": [
        {
            "type": "process",
            "label": "CMake: Build",
            "command": "cmake",
            "args": ["--build", "--preset", "clang-dev"],
            "windows": {
                "args": ["--build", "--preset", "msvc-dev"],
                "problemMatcher": "$msCompile"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "skills": { "paths": [".opencode/skills"] },
  "permission": {
    "read": { "*": "allow" },
    "edit": { "*": "allow" },
    "bash": { "*": "allow", "rm -rf *": "deny", "sudo *": "deny" },
    "clion_*": { "*": "allow" },
    "doom_loop": "deny",
    "external_directory": {
      "*": "ask",
      "C:\\Users\\bek4b\\AppData\\Local\\Temp\\opencode": "allow",
      "C:\\Users\\bek4b\\AppData\\Local\\Temp\\opencode/**": "allow"
    }
  },
  "mcp": {
    "clion": {
      "type": "remote",
      "url": "http://127.0.0.1:64362/stream",
      "enabled": true,
      "timeout": 30000
    },
    "crawl4ai": {
      "type": "remote",
      "url": "http://127.0.0.1:11235/mcp/sse",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CRAWL4AI_API_TOKEN}"
      }
    },
    "searxng": {
      "type": "local",
      "command": [
        "node",
        ".opencode/node_modules/mcp-searxng/dist/cli.js"
      ],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://127.0.0.1:8080"
      }
    },
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": true
    }
  }
}

const liquids_pass_src_1_density    = 1;
const liquids_pass_src_1_integrate  = 1;

#if use_liquids_xsph
const liquids_pass_src_1_xsph       = 0;

const liquids_pass_src_2_advect     = 1;
const liquids_pass_src_2_density    = 0;
const liquids_pass_src_2_integrate  = 0;

const liquids_pass_src_2_xsph       = 1;

const liquids_pass_src_3_advect     = 0;
const liquids_pass_src_3_density    = 1;
const liquids_pass_src_3_integrate  = 1;


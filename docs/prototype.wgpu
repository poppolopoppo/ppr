const liquids_pass_src_4_integrate  = 1;
#endif

fn liquidsDeltaTime() -> f32 {
    return custom.dt / liquids_num_passes;
}

#dispatch_once pass_liquids_init
#workgroup_count pass_liquids_init MAP_DISPATCH MAP_DISPATCH 1
@compute @workgroup_size(MAP_WORKGROUP, MAP_WORKGROUP)
fn pass_liquids_init(@builtin(global_invocation_id) id: vec3u) {
    particlesLiquidInit(&map.liquids, vec2i(id.xy));
}

// --- PASS#1 ---
#workgroup_count pass_liquids_advect_1 MAP_DISPATCH MAP_DISPATCH 1
@compute @workgroup_size(MAP_WORKGROUP, MAP_WORKGROUP)
fn pass_liquids_advect_1(@builtin(global_invocation_id) id: vec3u) {
    particlesAdvectAndClusterize(&map.liquids.particles, vec2i(id.xy), liquidsDeltaTime(), liquids_pass_src_1_advect);
}
#workgroup_count pass_liquids_density_1 MAP_DISPATCH MAP_DISPATCH 1
@compute @workgroup_size(MAP_WORKGROUP, MAP_WORKGROUP)
fn pass_liquids_density_1(@builtin(global_invocation_id) id: vec3u) {
    particlesLiquidDensity(&map.liquids, vec2i(id.xy), liquids_pass_src_1_density);
}
#workgroup_count pass_liquids_integrate_1 MAP_DISPATCH MAP_DISPATCH 1
@compute @workgroup_size(MAP_WORKGROUP, MAP_WORKGROUP)
fn pass_liquids_integrate_1(@builtin(global_invocation_id) id: vec3u) {
    const ping = liquids_pass_src_1_integrate;
    const pong = (liquids_pass_src_1_integrate + 1u) & 1u;

    let packed = particlesLiquidIntegration(&map.liquids, vec2i(id.xy), liquidsDeltaTime(), ping);

    map.liquids.particles[pong][mapIndex(vec2i(id.xy))] = packed;
}
#if use_liquids_xsph
#workgroup_count pass_liquids_xsph_1 MAP_DISPATCH MAP_DISPATCH 1

    const ping = liquids_pass_src_1_xsph;
    const pong = (liquids_pass_src_1_xsph + 1) & 1;

    let packed = particlesLiquidXSPHViscosity(&map.liquids, vec2i(id.xy), ping);

    map.liquids.particles[pong][mapIndex(vec2i(id.xy))] = packed;
}
#endif


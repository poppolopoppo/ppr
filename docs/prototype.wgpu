var<workgroup> s_mass : array<u32, MAP_WORKGROUP * MAP_WORKGROUP>;

#workgroup_count pass_liquids_total_mass MAP_DISPATCH MAP_DISPATCH 1
@compute @workgroup_size(MAP_WORKGROUP, MAP_WORKGROUP)
fn pass_liquids_total_mass( @builtin(global_invocation_id) id: vec3u,
                            @builtin(local_invocation_index) local_idx: u32) {

    let pair = particlesLoad(&map.liquids.particles[0], vec2i(id.xy));
    let mass = pair.m0_m1.x + pair.m0_m1.y;

    // atomicAdd(&map.liquids.total_mass, mass);

    s_mass[local_idx] = mass;
    workgroupBarrier();

    // parallel reduction in shared memory (binary tree)
    var stride = (MAP_WORKGROUP * MAP_WORKGROUP) / 2u;
    while (stride > 0u) {
        if (local_idx < stride) {
            s_mass[local_idx] = s_mass[local_idx] + s_mass[local_idx + stride];
        }
        workgroupBarrier();
        stride = stride / 2u;
    }

    // thread 0 of the workgroup commits the per-workgroup sum to global atomic
    if (local_idx == 0u) {
        atomicAdd(&map.liquids.total_mass, s_mass[0]);
    }
}


// ---------------------------------------------------------------------------
// Liquid Rendering (3D Metaballs)
// ---------------------------------------------------------------------------

fn liquidsAnisotropicDist3D(dx: vec3f, v: vec2f, radius: f32) -> f32 {
    let h = radius;
    // Parameters for anisotropy
    let alpha = custom.alpha;
    let beta = custom.beta;

    let v_len = min(length(v), particle_max_velocity);
    var sigma_par = h;
    var sigma_perp = h;
    if (v_len > M_EPSILON) {
        sigma_par  = h * (1.0 + alpha * v_len);
        sigma_perp = h / (1.0 + beta * v_len);
    }

    // Convert 2D velocity to 3D (z component is 0)
    let v3 = vec3f(v, 0.0);
    let dir = select(vec3f(1.0, 0.0, 0.0), normalize(v3), v_len > M_EPSILON);

    // Create 3D rotation matrix that rotates around the z-axis
    // This aligns the x-axis with the velocity direction
    let rot = mat3x3f(
        dir.x, -dir.y, 0.0,
        dir.y,  dir.x, 0.0,
        0.0,    0.0,   1.0
    );

    let x_local = rot * dx;
    let qx = x_local.x / sigma_par;
    let qy = x_local.y / sigma_perp;
    let qz = x_local.z / sigma_perp;  // z uses perpendicular scaling

    // q is the normalized distance (0 at center, ~1 at radius)
    return sqrt(qx*qx + qy*qy + qz*qz);
}

const liquids_particle_z = 0.66 * world_bounds_extent.z;

fn liquidsSDF(pos: vec3f) -> f32 {
    let id = particleToGrid(pos.xy);
    const window = 1;
    const radius = particle_max_radius;

    // Smooth Min Accumulator
    var d_min = 1000.0;
    let k_smooth = 0.6 * radius; // Blending factor

#if 0
    let local_p = vec3f(pos.xy, sin(M_PI * (pos.z - liquids_particle_z)));//vec3(pos.xy, max(pos.z, liquids_particle_z));
#else
    // let local_p = vec3f(pos.xy, pos.z - liquids_particle_z);
    let local_p = vec3(pos.xy, max(pos.z - liquids_particle_z, 0));
#endif

    // We reuse the map density grid for O(1) lookup
    for(var j = -window; j <= window; j++) {
    for(var i = -window; i <= window; i++) {
        let id1 = id + vec2i(i, j);
        let id1_clamped = clamp(id1, vec2i(0), map_dim_2d - 1);
        if (any(id1 != id1_clamped)) { continue; }

        let map_idx1 = mapIndex(id1);
        let p_packed = map.liquids.particles[0][map_idx1];
        let p = particlesUnpack(p_packed, gridToParticle(id1));

        if (p.m0_m1.x > 0) {
            let dx = local_p - vec3f(p.p0_p1.xy, 0);
            let d = length(dx) - radius;
            d_min = opSmoothUnion(d_min, d, k_smooth);
        }

        if (p.m0_m1.y > 0) {
            let dx = local_p - vec3f(p.p0_p1.zw, 0);
            let d = length(dx) - radius;
            d_min = opSmoothUnion(d_min, d, k_smooth);
        }
    }}

    // Intersect with floor plane at world_bounds_min.z
    let d_floor = world_bounds_min.z - pos.z;
    return max(d_min, d_floor);
}

fn liquidsNormal(pos: vec3f) -> vec3f {
    let e = vec2f(game.cam.zoom, 0.0);
    return normalizeSafe3(vec3f(
        liquidsSDF(pos + e.xyy) - liquidsSDF(pos - e.xyy),
        liquidsSDF(pos + e.yxy) - liquidsSDF(pos - e.yxy),
        liquidsSDF(pos + e.yyx) - liquidsSDF(pos - e.yyx)
    ), M_EPSILON);
}

fn liquidsTrace(eye: Ray3f, t0: f32, t1: f32, inside: f32, out_depth: ptr<function, f32>) -> bool {
    var t = t0;
    var p = eye.org + eye.dir * t - world_bounds_min;
    for(var i=0; i<100; i++) {
        let d = liquidsSDF(p);
        if (d*inside < 0.0) {
            *out_depth = t + d;
            return true;
        }
        let dt = abs(d) + 1e-3;
        t += dt;
        p += eye.dir * dt;
        if (t > t1) { break; }
    }

    *out_depth = t;
    return false;
}

fn liquidsTraceWorld(eye: Ray3f, depth_max: f32, out_depth: ptr<function, f32>) -> bool {
    let depth_min = worldOuterBackgroundIntersect(eye, 0.0);
    return liquidsTrace(eye, depth_min, depth_max, 1.0, out_depth);
}

fn liquidsShading(frag_coord: vec2f, eye: Ray3f, ddx_eye: Ray3f, ddy_eye: Ray3f, liq_depth: f32) -> vec3f {
    // --- Constants for water ---
    const water_ior = 1.333;        // Index of refraction for water at 20C
    const water_F0 = 0.02;          // Fresnel reflectance at normal incidence ((n-1)/(n+1))^2
    const water_roughness = 0.06;   // Low roughness for smooth water surface

    // --- Geometry Setup ---
    let liq_pos = eye.org + eye.dir * liq_depth;
    let liq_pos_local = liq_pos - world_bounds_min;
    let N_base = liquidsNormal(liq_pos_local);
    let V = -eye.dir; // View direction (towards camera)

    var tangent: vec3f;
    var binormal: vec3f;
    orthonormalBasis(N_base, &tangent, &binormal);

    // =========================================================================
    // High-frequency normal perturbation (water ripples/waves)
    // Uses 3D simplex noise FBM for proper volumetric water displacement
    // =========================================================================
    let ripple_scale = 0.5;           // Scale of ripple effect on normal
    let ripple_freq = 1.33;            // Spatial frequency of ripples
    let ripple_speed = 0.8;            // Animation speed
    const ripple_octaves = 3u;         // FBM octaves for detail

    // 3D sample position: XY spatial + animated time as Z for moving waves
    let wave_time = time.elapsed * ripple_speed;
    const wave_dir = normalize(vec3f(0.1,0.2,-1));
    let noise_pos = vec3f((liq_pos_local.xyz) * ripple_scale + wave_dir * wave_time);

    // Epsilon for gradient computation (finite differences)
    let eps = 0.1 / ripple_freq;

    // Sample 3D FBM noise at center and offset positions for gradient
    let h_c = turbulenceFbmNoise3D(noise_pos, ripple_octaves);
    let h_x = turbulenceFbmNoise3D(noise_pos + vec3f(eps, 0.0, 0.0), ripple_octaves);
    let h_y = turbulenceFbmNoise3D(noise_pos + vec3f(0.0, eps, 0.0), ripple_octaves);

    // Compute gradient (partial derivatives of height field)
    let gradient = vec2f(h_x - h_c, h_y - h_c) / eps;

    // Apply perturbation to shading normal (not geometry)
    var N = normalize(N_base + tangent * gradient.x * ripple_scale + binormal * gradient.y * ripple_scale);
    // if (frag_coord.x > R_halfRes.x) {
    //     N = N_base;
    // }

    // Ray differentials for derivatives
    var ddx_p: vec3f;
    var ddy_p: vec3f;
    hitRayDifferentials(liq_pos_local, N, ddx_eye, ddy_eye, &ddx_p, &ddy_p);

    // --- Fresnel at view angle (determines reflection vs transmission split) ---
    let NdotV = saturate(dot(N, V));
    let F_view = fresnelSchlick1(NdotV, water_F0);
    let T_view = 1.0 - F_view; // Transmission coefficient

    // =========================================================================
    // 1. SPECULAR REFLECTION (Direct Lighting)
    // Water only has specular, no diffuse. Use GGX microfacet BRDF.
    // =========================================================================
    var specular_direct = vec3f(0.0);

    for (var l = 0u; l < map.lights.count; l++) {
        let light = map.lights.each[l];

        let light_vec = light.position.xy - liq_pos_local.xy;
        let dist = length(light_vec);

        if (dist < light.range) {
            // Use reflection vector for representative point (area lights)
            let R = reflect(-V, N);

            // Get effective light direction for specular (handles area lights)
            let L = lightEffectiveDirection(light, liq_pos_local, R);

            let H = normalize(V + L);

            let NdotL = saturate(dot(N, L));
            let NdotH = saturate(dot(N, H));
            let VdotH = saturate(dot(V, H));

            // Skip if light is below surface
            if (NdotL > 0.0) {
                // Shadow term
                var shadow = lightShadowMapSample(vec2i(frag_coord), l, liq_pos_local.xy,
                                                  liq_pos_local.xy - ddx_p.xy,
                                                  liq_pos_local.xy - ddy_p.xy);


shadow = 1.0;

                // Light influence (attenuation + cone)
                let pos_on_light_plane = vec3f(liq_pos_local.xy, light.position.z);
                let Li = lightInfluence(light, pos_on_light_plane, N, shadow);

                // GGX Specular BRDF for water (no diffuse!)
                // D: GGX/Trowbridge-Reitz NDF
                let D = distributionGGX(NdotH, water_roughness);
                // G: Smith geometry function
                let G = geometrySmith(NdotV, NdotL, water_roughness);
                // F: Fresnel at half angle
                let F = fresnelSchlick1(VdotH, water_F0);

                // Cook-Torrance specular: D * G * F / (4 * NdotV * NdotL)
                let denom = max(NdotV * NdotL, M_EPSILON);
                let spec_brdf = (D * G * F) / denom;

                specular_direct += Li * spec_brdf * NdotL;
                //specular_direct += spec_brdf;
            }
        }
    }

    // =========================================================================
    // 2. SPECULAR REFLECTION (Indirect/Environment)
    // Trace reflection ray to get environment contribution
    // =========================================================================
    var specular_indirect = vec3f(0.0);

#if use_radiance_cascades
    // Reflection ray
    let refl_dir = reflect(-V, N);
    var refl_ray: Ray3f;
    refl_ray.org = liq_pos;
    refl_ray.dir = refl_dir;

    // Trace reflection
    let hit = worldTrace(refl_ray);

   // if (hit.y > M_EPSILON)
     {
        // Hit geometry - sample cascade irradiance at hit point
        let hit_pos = refl_ray.org + refl_ray.dir * hit.x;
        let hit_pos_map = hit_pos.xy - world_bounds_min.xy;
        let hit_normal = worldGradInsideBounds(hit_pos, game.cam.zoom);
        specular_indirect = cascadeIrradiance(hit_pos_map, hit_normal, true);

        // Distance-based falloff
        let falloff = exp(-hit.x * 0.01);
        specular_indirect *= falloff;
    }

    // Weight by Fresnel (more reflection at grazing angles)
    specular_indirect *= F_view;
#endif

    // =========================================================================
    // 3. VOLUMETRIC LIGHTING + TRANSMISSION
    // Ray march through water volume for in-scattering (god rays/caustics)
    // =========================================================================
    var transmitted = vec3f(0.0);
    var volumetric_inscatter = vec3f(0.0);

    // Refract ray direction (air to water: eta = 1.0 / water_ior)
    let refr_dir = refract(eye.dir, N, 1.0 / water_ior);
    let refr_valid = length(refr_dir) > M_EPSILON;

    var pix_refr = frag_coord;
    var depth_dist = 0.0;

    // Water volumetric properties
    let water_absorption = vec3f(0.45, 0.22, 0.05);  // Wavelength-dependent absorption
    let water_scattering = vec3f(0.02, 0.03, 0.04);  // Blue scatters more (Rayleigh-like)
    let water_extinction = water_absorption + water_scattering;
    // let extinction_scalar = rgbToLuminance(water_extinction);

    // Phase function: Henyey-Greenstein with slight forward bias for water
    let phase_g = 0.3; // Slight forward scattering

    if (refr_valid) {
        var refr_ray = Ray3f(liq_pos, normalize(refr_dir));

        var refr_hit: f32;
        let hit_success = liquidsTrace(refr_ray, 0.01, world_bounds_extent.z, -1.0, &refr_hit);

        //if (hit_success && refr_hit > 0.0)
        {
            let refr_pos = refr_ray.org + refr_ray.dir * refr_hit;
            let screen_pos = cameraWorldToScreen(game.cam.model, refr_pos);
            pix_refr = screen_pos.xy;
            depth_dist = refr_hit;
        }

        // =====================================================================
        // Volumetric ray marching through water
        // =====================================================================
        if (depth_dist > 0.0) {
            const num_vol_samples = 8;
            let ray_length = depth_dist;
            let ds = ray_length / f32(num_vol_samples);

            for (var i = 0; i < num_vol_samples; i++) {
                // Sample position along refracted ray
                let t = (f32(i) + 0.5) / f32(num_vol_samples);
                let sample_t = t * depth_dist;
                let sample_pos = refr_ray.org + refr_ray.dir * sample_t;
                let sample_pos_local = sample_pos - world_bounds_min;

                // Jitter for temporal stability
                let jitter = textureSampleLevel(channel0, bilinear_repeat,
                    game.frame_seed.xy + sample_pos_local.xy / game.cam.zoom, 0.0).xy;
                let jittered_pos = sample_pos_local.xy + (jitter * 2.0 - 1.0) * 0.5;

                // Transmittance from surface to this sample (Beer-Lambert)
                let optical_depth = water_extinction * sample_t;
                let transmittance_to_sample = exp(-optical_depth);

                // In-scattering: light reaching this point from all sources
                var inscatter_at_sample = vec3f(0.0);

                // Sample from radiance cascades (indirect/diffuse light in volume)
#if use_radiance_cascades
                let sample_normal = vec3f(0.0, 0.0, 1.0); // Upward bias for underwater
                let cascade_light = cascadeIrradiance(jittered_pos, sample_normal, false);
                inscatter_at_sample += cascade_light;
#endif

                // Direct light contribution - use precomputed radiance map (O(1) instead of looping lights)
                let direct_light = mapRadianceSample(jittered_pos);

                // Apply isotropic phase function for simplicity (no directional bias from map sample)
                let phase = 1.0 / (4.0 * M_PI);
                inscatter_at_sample += direct_light;// * phase;

                // Accumulate in-scattering with transmittance
                // inscatter * scattering_coeff * transmittance * ds
                let scattering_contrib = inscatter_at_sample * water_scattering * transmittance_to_sample * ds;
                volumetric_inscatter += scattering_contrib;
            }
        }
    }

    // Sample background through refraction
    let bg_col = passSampleLevelBilinearRepeat(CH_screenspace_distancefield_cells, pix_refr.xy / R.xy, 0).rgb;

    // Beer's Law absorption for background light
    let beer_attenuation = exp(-water_absorption * depth_dist);

    // Background attenuated by absorption + volumetric in-scattering
    transmitted = bg_col * beer_attenuation * T_view + volumetric_inscatter * T_view;

    // =========================================================================
    // 4. FINAL COMBINATION
    // Reflection (specular) + Transmission (background + volumetric)
    // Energy conservation: F reflects, (1-F) transmits
    // =========================================================================
    let total_radiance = specular_direct + specular_indirect + transmitted;

    // let total_radiance = volumetric_inscatter;

    return total_radiance;
}

#endif //!#if use_particle_simulation

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////
//////
//////  Direct lighting (point & spot lights)
//////
//////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////

///***************************************************************************
///---------------------------------------------------------------------------
/// Light spawing
///---------------------------------------------------------------------------
///***************************************************************************

#define LIGHTS_MAX_NUM              64u
#define LIGHTS_SHADOWMAP_RESOLUTION 512u

const lights_shadowmap_storage_size = (LIGHTS_SHADOWMAP_RESOLUTION * 2 - 1); // assume always pow2

fn textureSizeWithMips1D(mip0_size: u32) -> u32 {
    return (mip0_size * 2u - 1u);
}
fn textureMipOffset1D(mip0_size: u32, mip_level: u32) -> u32 {
    return select(0u, (mip0_size << 1u) - (mip0_size >> (mip_level - 1u)), mip_level > 0u);
}
fn textureMipSize1D(mip0_size: u32, mip_level: u32) -> u32 {
    return max(mip0_size >> mip_level, 1u);
}

#define use_lights_shadowmap        1

alias ShadowMomentsVSM = vec2<f16_or_32>;
alias ShadowMap = array<ShadowMomentsVSM, lights_shadowmap_storage_size>;

struct LightBuffer {
    each: array<Light, LIGHTS_MAX_NUM>,
    shadows: array<ShadowMap, LIGHTS_MAX_NUM>,
    count: u32,
    index: u32,
    selected: u32,
};

fn lightsSpawn(light: Light) -> u32 {
    let insert_at = min(map.lights.count,
                        map.lights.index % LIGHTS_MAX_NUM);
    map.lights.index += 1;
    map.lights.count = min(map.lights.count + 1, LIGHTS_MAX_NUM);
    map.lights.each[insert_at] = light;
    return insert_at;
}

fn lightsDestroy(id: u32) {
    if (id < map.lights.count) {
        map.lights.count--;

        for (var i = id; i < LIGHTS_MAX_NUM - 1; i++) {
            map.lights.each[i] = map.lights.each[i + 1];
        }
    }
}

fn lightsUpdate() {
    if (game.tool_allowed != tool_light) {
        // if (map.lights.selected < map.lights.count) {
        //     lightsDestroy(map.lights.selected);
        //     map.lights.selected = LIGHTS_MAX_NUM;
        // }
        return;
    }

    if (keyDown(key_Shift) && game.mouse_press == 1) {
        map.lights.selected = map.lights.count;
    }

    if (map.lights.selected >= map.lights.count) {
        var light: Light;
        light.direction = vec3f(0, 0, 1);
        light.color = vec3f(1);
        light.intensity = M_TAU * game.brush_radius;
        light.range = game.brush_radius;
        light.radius = 0.2;
        map.lights.selected = lightsSpawn(light);
    }

    let light = &map.lights.each[map.lights.selected];
    light.color = pastelPalette(saturate(cos(time.elapsed) * 0.5 + 0.5));
    light.intensity = M_TAU * game.brush_radius;
    light.range = game.brush_radius;
    light.radius = saturate(game.inner_radius)*  game.brush_radius;
    light.radius = max(0.0, light.radius - 1e-3f);

    if (mouse.click != 1) {
        return;
    }

    const surface_offset = 0.5;

    if (any(game.mouse_world_pos.xy != game.mouse_world_start.xy)) {
        let look_at = mapPushOutsideInterior(game.mouse_world_start.xy, surface_offset);

        light.direction = vec3f(look_at - game.mouse_world_pos.xy, 0);//-light.position.z);

        let dist = length(light.direction);
        light.direction /= max(dist, M_EPSILON);

        // place the light on the first surface intersecting light direction
        let hit = mapTrace(look_at, -light.direction.xy, M_EPSILON, dist);
        light.position = vec3f(
            look_at - light.direction.xy * (hit.z - 0.05),
            light.position.z );

        let phi = 0.01 + 0.99 * smoothstep(0.0, light.range, dist);
        light.outer_cone = M_PI * phi;
        light.inner_cone = M_PI * cub(phi);

    } else {
        let teleport_at = mapPushOutsideInterior(game.mouse_world_pos.xy, surface_offset);

        light.position = vec3f(teleport_at, 0.1 * game.brush_radius);
    }
}

///***************************************************************************
///---------------------------------------------------------------------------
/// Shadow mapping
///---------------------------------------------------------------------------
///***************************************************************************

// Convert world position to angular coordinate in light's cone [0, 1)
fn lightWorldToAngularCoord(light: Light, world_pos: vec2f) -> f32 {
    // vector from light to point
    let to_pos = world_pos - light.position.xy;

    let ld = normalizeSafe2(light.direction.xy, M_EPSILON);

    // build orthonormal basis: x axis = light direction, y axis = perpendicular
    let right = ld;                 // local x (angle = 0)
    let up    = vec2f(-ld.y, ld.x); // local y (90° ccw)

    // project into light-local 2D coordinates
    let lx = dot(to_pos, right);
    let ly = dot(to_pos, up);

    // // If the sample is extremely close to the light position, return 0.
    // // This avoids NaNs / instability in atan2 with 0/0.
    // if (lx == 0.0 && ly == 0.0) {
    //     return 0.0;
    // }

    // one atan2 call (result in [-PI, PI])
    let angle = atan2(ly, lx);

    // cone span (clamped)
    let outer_cone = select(M_PI, light.outer_cone, light.outer_cone > 0.0);
    let cone_span = 2.0 * outer_cone;

    // relative angle measured from cone start:
    // cone cover is [-outer_cone .. +outer_cone] around light dir (angle==0)
    // so the cone start is -outer_cone; we want angle - (-outer_cone) = angle + outer_cone
    var rel = angle + outer_cone;

    // robust wrap of rel into [-PI, PI] (floor-based modulo)
    // rel = rel - M_TAU * floor((rel + M_PI) / M_TAU);

    // map to [0,1) relative to cone span
    // note: if rel is negative after wrapping, fract() will normalize to [0,1)
    let coord = rel / cone_span;

    // returning fract(coord) gives stable wrap in [0,1)
    return fract(coord);
}

// Compute appropriate shadow map LOD based on screen-space footprint AND light radius
fn lightShadowMapComputeLOD(
    light: Light,
    world_pos: vec2f,
    ddx: vec2f,
    ddy: vec2f
) -> f32 {
    let outer_cone = select(M_PI, light.outer_cone, light.outer_cone > 0.0);
    let cone_span = 2.0 * outer_cone;

    if (cone_span <= M_EPSILON) {
        return 0.0;
    }

    // Compute how angular coordinate changes with screen-space position
    let to_pos = world_pos - light.position.xy;
    let dist = length(to_pos);
    let r_sq = max(dist * dist, M_EPSILON);
    let inv_r_sq = 1.0 / r_sq;

    // Derivative of atan2(y,x): d/dx = -y/(x²+y²), d/dy = x/(x²+y²)
    let dangle_dpos = vec2f(-to_pos.y, to_pos.x) * inv_r_sq;

    // Scale to angular coordinate space [0,1)
    let scale = 1.0 / cone_span;

    // Compute angular coordinate change per screen pixel
    let dangle_dx = abs(dot(dangle_dpos, ddx)) * scale;
    let dangle_dy = abs(dot(dangle_dpos, ddy)) * scale;

    // Convert to shadow map texel space
    let texels_per_unit = f32(LIGHTS_SHADOWMAP_RESOLUTION);
    let footprint_dx = dangle_dx * texels_per_unit;
    let footprint_dy = dangle_dy * texels_per_unit;

    // Use max footprint (anisotropic)
    let max_footprint = max(footprint_dx, footprint_dy);

    // Compute screen-space LOD (log2 of footprint in texels)
    let screen_lod = log2(max(max_footprint, 1.0));

    // Compute penumbra LOD from light radius (angular size of source)
    // The penumbra grows with distance from light (further = softer shadows)
    // but we cap it to avoid excessive blur that causes self-shadowing artifacts
    var penumbra_lod = 0.0;
    if (light.radius > 0.0) {
        // Use small angle approximation (radius/dist) which is more stable than atan
        // and naturally limits penumbra at close distances
        let angular_radius = light.radius / max(dist, light.radius);

        // Convert angular radius to shadow map texel span
        let penumbra_texels = angular_radius * texels_per_unit / outer_cone;
        penumbra_lod = log2(max(penumbra_texels, 1.0));

        // Cap penumbra LOD to avoid extreme blur that causes self-shadowing artifacts
        // Max LOD of 3 gives 8-texel blur which is visually soft without artifacts
        // penumbra_lod = min(penumbra_lod, 3.0);
    }

    // Final LOD is the maximum of screen footprint and penumbra requirement
    // This ensures soft shadows from area lights while maintaining proper filtering
    let lod = max(screen_lod, penumbra_lod);

    // Clamp to valid range
    let max_mip = f32(u32(floor(log2(f32(LIGHTS_SHADOWMAP_RESOLUTION)))));
    return clamp(lod, 0.0, max_mip);
}

// Sample shadow map moments with bilinear filtering
fn lightShadowMapSampleMomentsLinear(
    light_id: u32,
    mip_level: u32,
    coord: f32
) -> vec2f {
    let mip_size = textureMipSize1D(LIGHTS_SHADOWMAP_RESOLUTION, mip_level);
    let mip_offset = textureMipOffset1D(LIGHTS_SHADOWMAP_RESOLUTION, mip_level);

    // Compute integer indices with wrapping
    let coord_scaled = coord * f32(mip_size);
    let i0 = u32(floor(coord_scaled)) % mip_size;
    let i1 = (i0 + 1u) % mip_size;
    let frac = fract(coord_scaled);

    // Fetch 2 moments
    let m0 = vec2f(map.lights.shadows[light_id][mip_offset + i0]);
    let m1 = vec2f(map.lights.shadows[light_id][mip_offset + i1]);

    // Linear interpolation
    return mix(m0, m1, frac);
}

fn lightShadowMapSample(
    id: vec2i,
    light_id: u32,
    world_pos: vec2f,
    ddx: vec2f,
    ddy: vec2f
) -> f32 {
    let light = map.lights.each[light_id];

    // vector from light to shading point
    let to_pos = world_pos - light.position.xy;
    let dist_sq = length_sq2f(to_pos);

    // early outs
    if (dist_sq >= light.range*light.range) { return 1.0; }

    // cone/culling check
    let outer_cone = select(M_PI, light.outer_cone, light.outer_cone > 0.0);
    if (outer_cone > 0.0 && outer_cone < M_PI) {
        let pos_angle = atan2(to_pos.y, to_pos.x);
        let light_angle = atan2(light.direction.y, light.direction.x);
        let angle_diff = abs(normalizeAngle(pos_angle - light_angle));
        if (angle_diff > outer_cone) {
            return 0.0;
        }
    }

    // mip level from penumbra width
    let mip_level = lightShadowMapComputeLOD(light, world_pos, ddx, ddy);
    let mip0 = u32(floor(mip_level));

    // angular coord [0,1)
    let angular_coord = lightWorldToAngularCoord(light, world_pos);
    let taa_noise = interleavedGradientNoise(id.xy, time.frame);

    // sample both mips and perform bilinear interpolation
    let angular_jitter0 = (taa_noise - 0.5) / f32(LIGHTS_SHADOWMAP_RESOLUTION >> mip0);
    let angular_jitter1 = (taa_noise - 0.5) / f32(LIGHTS_SHADOWMAP_RESOLUTION >> (mip0 + 1));
    let moments = mix(  lightShadowMapSampleMomentsLinear(light_id, mip0, angular_coord + angular_jitter0),
                        lightShadowMapSampleMomentsLinear(light_id, mip0 + 1, angular_coord + angular_jitter1),
                        fract(mip_level) );

    // Variance Shadow Mapping
    let inverse_depth = inverseSqrt(dist_sq);
    let shadow_p = step(moments.x, inverse_depth);
    let variance = moments.y - moments.x * moments.x;

    let shadow_d = inverse_depth - moments.x;
    var shadow_p_max = variance / max(variance + shadow_d*shadow_d, M_EPSILON);
    shadow_p_max = (shadow_p_max - 0.2) / 0.8;

    return min(max(shadow_p, shadow_p_max), 1.0);
}

///***************************************************************************
///---------------------------------------------------------------------------
/// Shadow map generation pass
///---------------------------------------------------------------------------
///***************************************************************************

fn lightShadowMapRayDir(ld: vec2f, outer_cone: f32, idx: u32, num: u32) -> vec2f {
    // Perpendicular basis for angular rotation
    let right = ld;                 // direction of center of cone
    let up    = vec2f(-ld.y, ld.x); // 90° rotated

    // Cone span & interpolation parameter

    let cone_span = 2.0 * outer_cone;

    // t in [0,1)
    let t = (f32(idx) + 0.5) / f32(num);

    // Angle relative to cone center (center = 0)
    // Cone covers [-outer_cone, +outer_cone]
    let phi = (-outer_cone) + t * cone_span;
    return right * cos(phi) + up * sin(phi);
}

#workgroup_count pass_lights_shadowmaps 1 LIGHTS_MAX_NUM 1
@compute @workgroup_size(256, 1)
fn pass_lights_shadowmaps(
    @builtin(global_invocation_id) id : vec3u,
    @builtin(local_invocation_index) local_idx: u32
) {
    let light_id = id.y;
    let light = map.lights.each[light_id];

    // compute how many shadow texels each thread must produce
    let entries_per_thread = (LIGHTS_SHADOWMAP_RESOLUTION + 256u - 1u) / 256u;

    // Base level writes (each thread writes entries_per_thread texels, guarded)
    let ld = normalizeSafe2(light.direction.xy, M_EPSILON);
    let outer_cone = select(M_PI, light.outer_cone, light.outer_cone > 0.0);
    for (var j: u32 = 0u; j < entries_per_thread; j = j + 1u) {
        // global texel index in [0, LIGHTS_SHADOWMAP_RESOLUTION)
        let tex_idx = local_idx + j * 256u;

        const sub_sampling = 4u;
        var moments = vec2f(0);
        for (var i = 0u; i < sub_sampling; i++) {
              // compute ray direction for that texel index (use your existing helper)
            let rd = lightShadowMapRayDir(ld, outer_cone, tex_idx * sub_sampling + i, LIGHTS_SHADOWMAP_RESOLUTION * sub_sampling);

            // sphere-trace / raymarch to get hit distance (use your existing mapTrace)
            let hit = mapTrace(light.position.xy, rd, M_EPSILON, light.range);

            // compute safe inverse depth with small bias to avoid division by zero & reduce self-shadowing
            const DEPTH_BIAS_SMALL : f32 = 5*1e-2; // small bias to avoid 1/0 and reduce self-shadowing
            let depth = hit.z;
            let inv_depth = 1.0 / (depth + DEPTH_BIAS_SMALL);

            moments += vec2f(inv_depth, inv_depth*inv_depth);
        }
        moments /= f32(sub_sampling);

        map.lights.shadows[light_id][tex_idx] = ShadowMomentsVSM(saturate(moments));
    }

    // synchronize threads in workgroup before building mips
    workgroupBarrier();

    // --- Build mip chain with improved filtering ---
    // Use a 4-tap Gaussian-weighted filter for better quality VSM mips
    // This reduces aliasing and shadow acne compared to simple 2-tap box filter
    var prev_offset : u32 = 0u;
    var prev_size : u32 = LIGHTS_SHADOWMAP_RESOLUTION;
    var mip_level : u32 = 1u;
    var current_size : u32 = prev_size >> 1u;

    while (current_size > 0u) {
        let current_offset = textureMipOffset1D(LIGHTS_SHADOWMAP_RESOLUTION, mip_level);

        for (var j2: u32 = 0u; j2 < entries_per_thread; j2 = j2 + 1u) {
            let base_idx = local_idx + j2 * 256u;
            if (base_idx >= current_size) { continue; }

            // 4-tap Gaussian filter with weights [1, 3, 3, 1] / 8
            // This provides smoother mip transitions and reduces shadow acne
            let center = base_idx * 2u;

            // Sample 4 texels with wrapping for the circular shadow map
            let i0 = prev_offset + ((center + prev_size - 1u) % prev_size); // left neighbor
            let i1 = prev_offset + (center % prev_size);                     // center-left
            let i2 = prev_offset + ((center + 1u) % prev_size);              // center-right
            let i3 = prev_offset + ((center + 2u) % prev_size);              // right neighbor

            let v0 = vec2f(map.lights.shadows[light_id][i0]);
            let v1 = vec2f(map.lights.shadows[light_id][i1]);
            let v2 = vec2f(map.lights.shadows[light_id][i2]);
            let v3 = vec2f(map.lights.shadows[light_id][i3]);

            // Gaussian weights [1, 3, 3, 1] / 8 - smoother than box filter
            let moments = (v0 + v1 * 3.0 + v2 * 3.0 + v3) * 0.125;

            // For VSM stability, also clamp variance to be non-negative
            // variance = E[x²] - E[x]² must be >= 0
            let mean = moments.x;
            let mean_sq = max(moments.y, mean * mean);

            map.lights.shadows[light_id][current_offset + base_idx] = ShadowMomentsVSM(saturate(vec2f(mean, mean_sq)));
        }

        // barrier before next mip level
        workgroupBarrier();

        // advance to next level
        prev_offset = current_offset;
        prev_size = current_size;
        mip_level = mip_level + 1u;
        current_size = prev_size >> 1u;
    }
}

///***************************************************************************
///---------------------------------------------------------------------------
/// Forward lighting
///---------------------------------------------------------------------------
///***************************************************************************

#define use_lighting_trace_indirect_specular (use_hq_rendering && 1)

fn lightingIndirect(id: vec2i, view: vec3f, geo: Geometry, mat: Material) -> vec3f {
#if use_radiance_cascades
    let taa_noise = interleavedGradientNoise(id, time.frame);
    let taa_jitter = taaFragmentOffset(0) * 3.0 * (taa_noise - 0.5);
    let indirect_pos = geo.position.xy + taa_jitter;
    let diffuse_indirect = cascadeIrradiance(indirect_pos, geo.bent_normal, false);

    // Initialize to zero to avoid undefined behavior when skipping specular trace
    var specular_indirect = vec3f(0.0);

    // Fresnel reflectance at normal incidence (dielectrics ~0.04, metals use albedo as F0)
    var F0 = mix(vec3f(0.04), mat.albedo, mat.metallic);

    // Components - clamp cosTheta to avoid issues with back-facing normals
    let NdotV = saturate(abs(dot(view, geo.normal)));
    let F = fresnelSchlick3(NdotV, F0);

    // Apply roughness-based jitter to reflection direction for TAA temporal supersampling
    // Screen-space derivatives (ddx, ddy) ensure jitter is coherent with pixel footprint
    // Rougher surfaces get more jitter to sample the wider BRDF lobe over time
    let roughness_jitter = (taa_noise - 0.5) * geo.tangent + ((1.0 - taa_noise) - 0.5) * geo.binormal;

    var refl: Ray3f;
    refl.org = geo.position + world_bounds_min;
    // refl.dir = reflect(view, geo.normal);
    // refl.dir = normalize(refl.dir + jitter * mat.roughness);
    refl.dir = reflect(view, normalize(geo.normal + roughness_jitter * mat.roughness));

#if use_lighting_trace_indirect_specular
    // Only compute specular for materials with significant reflectance (metals)
    // Dielectrics have low F (~4%) and traced specular is expensive/noisy
    if (mat.metallic > 0.04 || mat.roughness < 0.2) {
        // Sample environment map for sky/distant reflections fallback
        var specular_env = vec3f(0);
#if 0
        let long_lat = dirToLatLongUV(refl.dir);
        let roughness_grad = taa_noise + mat.roughness * 10.0;
        specular_env = textureSampleGrad(channel0, trilinear_repeat, long_lat, geo.ddx.xy * roughness_grad, geo.ddy.xy * roughness_grad).rgb;
        specular_env = sRgbToLinear(specular_env);
#endif

        // Hybrid reflection: trace ray to find hit, then sample cascade irradiance at hit point
        // This combines accurate ray-traced geometry with pre-computed GI from cascades
        let hit = worldTrace(refl);

        if (hit.y > M_EPSILON) {
            // Ray hit geometry - sample cascade irradiance at hit position
            let hit_pos = refl.org + refl.dir * hit.x;
            let hit_pos_map = hit_pos.xy - world_bounds_min.xy;

            // Compute hit normal from the world SDF gradient
            let hit_normal = worldGradInsideBounds(hit_pos, game.cam.zoom);

            // Sample the cascade irradiance at the hit point
            // This gives us the indirect lighting visible from the reflected surface
            specular_indirect = cascadeIrradiance(hit_pos_map, hit_normal, true);

            // Optional: add distance-based falloff for very far reflections
            let falloff = exp(-hit.x * 0.01);
            specular_indirect = mix(specular_env, specular_indirect, falloff);
        } else {
            // Ray escaped to sky - use environment map
            specular_indirect = specular_env;
        }
    }
#else
    if (mat.metallic > 0.01) {
        let long_lat = dirToLatLongUV(refl.dir);
        let roughness_grad = taa_noise + mat.roughness * 10.0;
        specular_indirect = textureSampleGrad(channel0, trilinear_repeat, long_lat, geo.ddx.xy * roughness_grad, geo.ddy.xy * roughness_grad).rgb;
        specular_indirect = sRgbToLinear(specular_indirect);
    }
#endif

    // Indirect lighting combination:
    // - Diffuse uses albedo modulation (simplified, allows some diffuse on metals for artistic look)
    // - Specular uses Fresnel F weighted by metallic (metals get full specular, dielectrics less)
    // Note: Physically metals should have no diffuse, but traced specular alone is often too dim
    var indirect = diffuse_indirect * mat.albedo + specular_indirect * F;

    return indirect / M_TAU;
#else
    return vec3f(1.0);
#endif
}

fn lightingGeometry(pos: vec3f, ddx: vec3f, ddy: vec3f, nrm: vec3f, use_screen_space: bool) -> Geometry {
    var geo: Geometry;
    geo.position = pos;
    geo.ddx = ddx;
    geo.ddy = ddy;
    geo.normal = nrm;
    geo.bent_normal = nrm;

    var tangent: vec3f;
    var binormal: vec3f;
    orthonormalBasis(nrm, &tangent, &binormal);
    geo.tangent = tangent;
    geo.binormal = binormal;

    let map_grad = mapGrad(pos.xy);
    geo.sdf = map_grad.z;

    // light first interior cell the same as the closest exterior
    if (!use_screen_space && geo.sdf < 0.0 && geo.sdf > -1.0) {
        geo.position = vec3f(
            geo.position.xy - map_grad.xy * (map_grad.z - sqrt(2) * 0.5 - M_EPSILON),
            geo.position.z );
    }

    return geo;
}

fn lightingDirect(id: vec2i, view: vec3f, geo: Geometry, mat: Material) -> vec3f {
    var radiance = mat.emissive.rgb;

    for (var l = 0u; l < map.lights.count; l++) {
        let light = map.lights.each[l];

        var L2 = (light.position.xy - geo.position.xy);
        let d2 = length(L2);

        if (d2 < light.range) {
            L2 /= max(d2, M_EPSILON);

            let shadow = lightShadowMapSample(id, l, geo.position.xy, geo.ddx.xy, geo.ddy.xy);

            let pos_on_light_plane = vec3f(geo.position.xy, light.position.z);
            let Li = lightInfluence(light, pos_on_light_plane, geo.normal, shadow);

            // For area lights, use representative point for specular direction
            // This gives more accurate specular highlights for extended light sources
            let R = reflect(view, geo.normal); // Reflection vector for specular
            let L = lightEffectiveDirection(light, geo.position, R);

            let brdf = brdfCookTorrance(geo.normal, -view, L, mat.albedo, mat.metallic, mat.roughness);

            radiance += Li * brdf;
        }
    }

    return radiance;
}

///***************************************************************************
///---------------------------------------------------------------------------
/// Radiance packing/unpacking
///---------------------------------------------------------------------------
///***************************************************************************

#if 1
alias PackedRadiance = RGB9E5;

fn radiancePack(radiance: vec3f) -> PackedRadiance {
    return linearToRGB9E5(radiance / M_TAU);
}

fn radianceUnpack(packed: PackedRadiance) -> vec3f {
    return RGB9E5ToLinear(packed) * M_TAU;
}

#else
alias PackedRadiance = vec4<f16_or_32>;

fn radiancePack(radiance: vec3f) -> PackedRadiance {
    return PackedRadiance(vec4f(radiance, 0.0));
}

fn radianceUnpack(packed: PackedRadiance) -> vec3f {
    return vec3f(packed.rgb);
}

#endif

///***************************************************************************
///---------------------------------------------------------------------------
/// Compute map radiance in world space grid
///---------------------------------------------------------------------------
///***************************************************************************

#define use_radiance_progressive 1 // accumulate radiance values overtime to get multiples bounces in global illumination for a minor cost

fn mapRadianceNearest(id: vec2i) -> vec3f {
    if (any((id < vec2i(0)) | (id >= vec2i(map_dim_2d)))) {
        return vec3f(0);
    }

    let map_idx = mapIndex(id);
    return radianceUnpack(map.radiance[map_idx]);
}

fn mapNearestInterior(p: vec2f) -> vec2u {
    let p_clamp = clamp(p, vec2f(0), vec2f(map_dim_2d - 1));

    var map_idx = mapIndex(vec2i(floor(p_clamp)));
    var cell = map.cells[map_idx];

    if (!cellIsInterior(cell)) {
        let grad = mapGrad(p_clamp);

        if (grad.z <= 0.01) {
            map_idx = u32(floor(grad.w));
            cell = map.cells[map_idx];
        }
    }

    return vec2u(map_idx, cell);
}

fn quadraticWeightsBSpline(f: f32) -> vec3f {
    // Correct quadratic B-spline weights for f ∈ [0, 1)
    // All weights non-negative, sum to 1
    let f2 = f * f;
    let w0 = 0.5 - f + 0.5 * f2;    // 0.5 * (1-f)²
    let w1 = 0.5 + f - f2;          // 0.5 + f - f²
    let w2 = 0.5 * f2;              // 0.5 * f²
    return vec3f(w0, w1, w2);
}

fn mapRadianceSample(p: vec2f) -> vec3f {
    if (any((p < vec2f(0)) | (p >= vec2f(map_dim_2d)))) {
        return vec3f(0);
    }

#if 0 // bilinear interpolation
    // let bilinear = bilinearSamples(p);
    let bilinear = hermiteSamples(p);
    let weights = bilinearWeights(bilinear.ratio);

    var radiance = vec3f(0);
    for (var i = 0u; i < 4u; i++) {
        let map_idx = mapIndexClamp(vec2i(bilinear.base_index + bilinearOffset(i)));
        radiance += radianceUnpack(map.radiance[map_idx]) * weights[i];
    }
    return radiance;

#else // quadratic interpolation
    let base = vec2i(floor(p)) - vec2i(1);
    let f = fract(p);

    let wx = quadraticWeightsBSpline(f.x);
    let wy = quadraticWeightsBSpline(f.y);

    var result = vec3f(0.0);
    for (var j = 0; j < 3; j++) {
    for (var i = 0; i < 3; i++) {
        let idx = mapIndexClamp(base + vec2i(i, j));
        result += wx[i] * wy[j] * radianceUnpack(map.radiance[idx]);
    }}
    return result;

#endif
}

fn mapDirectLighting(world_pos: vec2f) -> vec3f {
    let map_pos = vec2i(floor(world_pos));
    let map_idx = mapIndex(map_pos);

    let cell = map.cells[map_idx];
    let elem = cellElement(cell);
    var mat = cellMaterial(cell);

    const ddx = vec3f(1.0, 0.0, 0.0);
    const ddy = vec3f(0.0, 1.0, 0.0);
    var geo = lightingGeometry(vec3f(world_pos, 0), ddx, ddy, vec3f(0,0,1), false);

    if (geo.sdf < 0) {
        geo.normal = normalizeSafe3(mapGrad(world_pos).xyz, M_EPSILON);
    }

    // direct lighting
    var radiance = lightingDirect(map_pos, vec3(0,0,-1), geo, mat);

    // optional diffuse boost to make opaque material emissive
    radiance += mat.albedo * custom.diffuse_boost;

    // indirect lighting from previous frame
#if use_radiance_progressive && use_radiance_cascades
    let indirect = cascadeIrradiance(geo.position.xy, geo.normal, false);
    let kd = 1.0;//(1.0 - 0.5 * mat.metallic); // scalar
    let alpha = custom.progressive_radiance;
    radiance += alpha * saturate(mat.albedo * kd * indirect - mat.emissive);
#endif

    return radiance;
}

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////
//////
//////  Radiance Cascade Global Illumination
//////
//////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////

#if use_radiance_cascades

#define RADIANCE_NUM_CASCADES 6

#define use_radiance_cascades_bilinear      1 // interpolate 4 rays going from current probe center to parent center, fixes halo
#define use_radiance_cascades_inplace       1 // trace radiance for collision when computing irradiance
#define use_radiance_cascades_sky           1 // last cascade is merged with a fake sky integral
#define use_radiance_cascades_pingpong      0 // store only 2 cascades in memory to compute all of them with buffer ping-ponging ([0] stores the final results)
#define use_radiance_cascades_brdf          0 // evaluate brdf at each ray instead of sampling the map radiance cache
#define use_radiance_cascades_temporal      1 // accumulate probes over time with exponential moving average
#define use_radiance_cascades_sparseupdate  1 // only update 1/4th of the probes per frame, since they are in world space it's barely visible and it's very effective

struct GlobalIllumination {
    radiance_cascades: RadianceCascades,

    temporal_radiance: array<vec4<f16_or_32>, cascade_stride>,
};


#workgroup_count pass_map_direct_lighting MAP_DISPATCH MAP_DISPATCH 1
@compute @workgroup_size(MAP_WORKGROUP, MAP_WORKGROUP)
fn pass_map_direct_lighting(@builtin(global_invocation_id) id: vec3u) {
    if (any(vec2i(id.xy) >= map_dim_2d - 1)) {
        return;
    }

#if use_radiance_cascades_temporal
    // let jitter = halton(time.frame % 8u + 1u);
    let jitter = taaFragmentOffset(time.frame) + 0.5;
#else
    const jitter = 0.5;
#endif

    let p = vec2f(id.xy) + jitter;
    var radiance = mapDirectLighting(p);

    let map_idx = mapIndex(vec2i(id.xy));

#if use_radiance_cascades_temporal
    if (time.frame > 0) {
        let prev_radiance = radianceUnpack(map.radiance[map_idx]);
        radiance = mix(radiance, prev_radiance, exp(-5.0*time.delta));
    }
#endif

    map.radiance[map_idx] = radiancePack(radiance);
}

///***************************************************************************
///---------------------------------------------------------------------------
/// Radiance cascades properties
///---------------------------------------------------------------------------
///***************************************************************************

const cascade_viewport = vec2u(map_dim_2d.xy);
const cascade_stride = cascade_viewport.x * cascade_viewport.y;

#if use_radiance_cascades_pingpong
// ping-pong between 2 radiance cascade storages, making memory cost independent of the number of cascades
alias RadianceCascades = array<vec4<f16_or_32>, cascade_stride * 2>;
#else
// store all radiance cascades in memory, useful for debugging individual cascade values
alias RadianceCascades = array<vec4<f16_or_32>, cascade_stride * RADIANCE_NUM_CASCADES>;
#endif

fn cascadeOffset(cascade: u32) -> u32 {
#if use_radiance_cascades_pingpong
    let ping_pong = (cascade & 1); // cascade [0] with final results is stored at [0]
    return ping_pong * cascade_stride;
#else
    return cascade * cascade_stride;
#endif
}

fn cascadeProbeSize(cascade: u32) -> u32 {
    return 2u << cascade;
}

fn cascadeIntervalLength(cascade: u32) -> f32 {;
#if 1
    let cascade_c0_length = f32(cascade_viewport.x) *
                            custom.penumbra_width *
                            1e-3;
    let cascade_scale = select(f32(1u << (2u * cascade - 1)), 0, cascade == 0);
    return cascade_c0_length * (cascade_scale + use_radiance_cascades_inplace);
#else
    let cascade_c0_length = custom.penumbra_width;
    let cascade_scale = pow(2.0, f32(cascade));      // double per cascade
    return cascade_c0_length * cascade_scale;
#endif
}

fn cascadeInterval(cascade: u32) -> vec2f {
    const overlap = 1.0; // no ray overlap
    return vec2(cascadeIntervalLength(cascade),
                cascadeIntervalLength(cascade + 1) * overlap );
}

fn cascadeNumDirs(cascade: u32) -> u32 {
    return 4u << (2u * cascade);
}

fn cascadeProbeDir(cascade: u32, phi: u32) -> vec2f {
    let num_dirs = cascadeNumDirs(cascade);
    let ratio = (f32(phi) + 0.5) / f32(num_dirs);
    return dir2(ratio);
}

fn cascadeProbeCenter(cascade: u32, probe: vec2u) -> vec2f {
    let probe_size = cascadeProbeSize(cascade);
#if use_radiance_cascades_temporal
    let jitter = taaFragmentOffset(time.frame);
    return (vec2f(probe) + 0.5) * f32(probe_size) + jitter;
#else
    return (vec2f(probe) + 0.5) * f32(probe_size);
#endif
}

fn cascadeBilinearSamples(cascade: u32, world_pos: vec2f) -> BilinearSamples {
    let probe_size = cascadeProbeSize(cascade);
    let probe_index2f = (world_pos / f32(probe_size)) - 0.5;
    return bilinearSamples(probe_index2f);
}

fn cascadeMergeInterval(near: vec4f, far: vec4f) -> vec4f {
    return vec4f(
        near.rgb + near.a * far.rgb,
        near.a * far.a );
}

struct ProbeLocation {
    probe: vec2u,
    phi: u32,
    cascade: u32,
};

fn pixelToProbeLocation(pixel: vec2u, cascade: u32) -> ProbeLocation {
    let probe_size = cascadeProbeSize(cascade);
    let probe_index = pixel / probe_size;
    let probe_pos = probe_index * probe_size;
    let phi_rel = pixel - probe_pos;
    let phi = phi_rel.y * probe_size + phi_rel.x;
    return ProbeLocation(probe_index, phi, cascade);
}

fn probeLocationToPixel(location: ProbeLocation) -> vec2u {
    let probe_size = cascadeProbeSize(location.cascade);
    let probe_pos = location.probe * probe_size;
    let phi_rel = vec2u(location.phi % probe_size, location.phi / probe_size);
    return phi_rel + probe_pos;
}

fn probeLocationToPixelIndex(location: ProbeLocation) -> u32 {
    let phi_pos = probeLocationToPixel(location);
    let probe_linear_offset = phi_pos.y * cascade_viewport.x + phi_pos.x;
    return cascadeOffset(location.cascade) + probe_linear_offset;
}

fn probeLocationToPixelIndexClamp(location: ProbeLocation) -> u32 {
    var phi_pos = probeLocationToPixel(location);
    phi_pos = clamp(phi_pos, vec2u(0), cascade_viewport - 1);
    let probe_linear_offset = phi_pos.y * cascade_viewport.x + phi_pos.x;
    return cascadeOffset(location.cascade) + probe_linear_offset;
}

fn probeLocationChild(location: ProbeLocation) -> ProbeLocation {
    let probe_center = cascadeProbeCenter(location.cascade, location.probe);
    return pixelToProbeLocation(vec2u(floor(probe_center)), select(0, location.cascade - 1, location.cascade > 0));
}

fn probeLocationParent(location: ProbeLocation) -> ProbeLocation {
    let probe_center = cascadeProbeCenter(location.cascade, location.probe);
    return pixelToProbeLocation(vec2u(floor(probe_center)), location.cascade + 1);
}

///***************************************************************************
///---------------------------------------------------------------------------
/// Radiance cascade compute
///---------------------------------------------------------------------------
///***************************************************************************

fn radianceCascadeComputeLast(location: ProbeLocation) -> vec4f {
    let probe_center = cascadeProbeCenter(location.cascade, location.probe);
    let ray_interval = cascadeInterval(location.cascade);

    let parent_num_dirs = cascadeNumDirs(location.cascade + 1);
    let avg_num_dirs =  cascadeNumDirs(location.cascade + 1) /
                        cascadeNumDirs(location.cascade);

    var radiance = vec4f(0);
    for (var phi = 0u; phi < avg_num_dirs; phi++) {
        var radiance_far: vec4f;
#if use_radiance_cascades_sky
        // If we are the top-level cascade, then there's no other
        // cascade to merge with, so instead merge with the sky radiance
        let parent_phi = f32(location.phi * avg_num_dirs + phi) + 0.5;
        var angle = (1.0 - vec2f(parent_phi, parent_phi + 1) / f32(parent_num_dirs));


        angle += fract(time.elapsed * 0.2 * custom.time_of_day);


        angle *= M_TAU;
        angle.x = normalizeAnglePositive(angle.x);
        angle.y = normalizeAnglePositive(angle.y);

        angle = vec2f(
            min(angle.x, angle.y),
            max(angle.x, angle.y)
        );

        let norm = M_TAU * custom.sky_intensity / (angle.y - angle.x);

        let probe_dir = cascadeProbeDir(location.cascade + 1, location.phi * avg_num_dirs + phi);

        radiance_far = vec4f(radianceIntegrateSky(angle) * norm, 1.0);
#else
        radiance_far = vec4f(0,0,0,1);
#endif

        let ray_start = probe_center + probe_dir * ray_interval.x;
        let ray_end = probe_center + probe_dir * ray_interval.y;

        var radiance_near: vec4f;
        radiance_near = radianceTraceMap(ray_start, ray_end);

        radiance += cascadeMergeInterval(radiance_near, radiance_far);
    }
    radiance /= f32(avg_num_dirs);

    return radiance;
}

fn radianceCascadeCompute(location: ProbeLocation) -> vec4f {
    var parent : ProbeLocation;
    parent.cascade = location.cascade + 1;

    let probe_center = cascadeProbeCenter(location.cascade, location.probe);
    let probe_dir = cascadeProbeDir(location.cascade, location.phi);
    let ray_interval = cascadeInterval(location.cascade);

    const num_samples = 4u;
    let bilinear = cascadeBilinearSamples(parent.cascade, probe_center);
    let weights = bilinearWeights(bilinear.ratio);
    let avg_num_dirs =  cascadeNumDirs(parent.cascade) /
                        cascadeNumDirs(location.cascade);

    var radiance = vec4f(0);
    for (var sp = 0u; sp < num_samples; sp++) {
        parent.probe = bilinear.base_index + bilinearOffset(sp);

        let parent_probe_center = cascadeProbeCenter(parent.cascade, parent.probe);
        let ray_start = probe_center + probe_dir * ray_interval.x;
        let ray_end = parent_probe_center + probe_dir * ray_interval.y;

        var radiance_near: vec4f;
        radiance_near = radianceTraceMap(ray_start, ray_end);

        var radiance_sp = vec4f(0);
        for (var phi = 0u; phi < avg_num_dirs; phi++) {
            parent.phi = location.phi * avg_num_dirs + phi;

            let pixel_index = probeLocationToPixelIndexClamp(parent);
            let radiance_far = vec4f(game.gi.radiance_cascades[pixel_index]);

            radiance_sp += cascadeMergeInterval(radiance_near, radiance_far);
        }
        radiance += radiance_sp * weights[sp];
    }
    radiance /= f32(avg_num_dirs);

    return radiance;
}

fn cascadeIrradiance(world_pos: vec2f, nrm: vec3f, inplace: bool) -> vec3f {
    if (any((world_pos < vec2f(0)) | (world_pos >= vec2f(map_dim_2d)))) {
        return vec3f(1);
    }

    var location = ProbeLocation();
    location.cascade = 0;

    let bilinear = cascadeBilinearSamples(location.cascade, world_pos);
    let weights = bilinearWeights(bilinear.ratio);

    let num_dirs = cascadeNumDirs(location.cascade);

    const num_samples = 4u;

    var radiance = vec3f(0);
    for (var sp = 0u; sp < num_samples; sp++) {
        location.probe = bilinear.base_index + bilinearOffset(sp);

        var radiance_sp = vec3f(0);
        for (var phi = 0u; phi < num_dirs; phi++) {
            location.phi = phi;

            let pixel_index = probeLocationToPixelIndexClamp(location);
#if use_radiance_cascades_temporal
            let radiance_far = vec4f(game.gi.temporal_radiance[pixel_index]);
#else
            let radiance_far = vec4f(game.gi.radiance_cascades[pixel_index]);
#endif

            let probe_dir = cascadeProbeDir(location.cascade, location.phi);

            var radiance_near = vec4f(0,0,0,1);
#if use_radiance_cascades_inplace
            if (inplace) {
                let probe_center = cascadeProbeCenter(location.cascade, location.probe);
                radiance_near = radianceTraceMap(   world_pos,
                                                    world_pos + probe_dir * cascadeIntervalLength(0) );
            }
#endif

            let nDotL = max(dot(nrm.xy, probe_dir) * 0.5 + 0.5, nrm.z);
            radiance_sp += cascadeMergeInterval(radiance_near, radiance_far).rgb * nDotL;
        }
        radiance += radiance_sp * weights[sp];
    }
    radiance /= f32(num_dirs);

    return radiance * M_TAU;
}

///***************************************************************************
///---------------------------------------------------------------------------
/// Map radiance trace
///---------------------------------------------------------------------------
///***************************************************************************

#define use_radiance_trace_debug 0
#if use_radiance_trace_debug
var<private> g_enable_radiance_trace_debug : bool;

fn radianceTraceDebugRay(ray_start: vec2f, ray_end: vec2f, radiance: vec3f) {
    if (!g_enable_radiance_trace_debug) {
        return;
    }

    let restore_style = canvas.style;

    canvas.style.fill = vec4f(radiance.rgb, 0.5);
    canvas.style.glow_width = 0;
    canvas.style.stroke_width = 0;

    canvasDrawArrow(
        ray_start,
        ray_end,
        2 * canvas.ddxyLen );

    canvas.style = restore_style;
}
#endif

fn radiancePrepareTrace(
    ray_start: vec2f,
    ray_end: vec2f,
    ray_aabb: vec4f,
    ray_dir: ptr<function, vec2f>,
    ray_interval: ptr<function, vec2f> ) -> bool {

    var rd = ray_end - ray_start;
    var min_t = 0.0;
    var max_t = length(rd);
    rd /= max(max_t, M_EPSILON);

    *ray_dir = rd;
    *ray_interval = vec2f(min_t, max_t);

    let aabb = intersectAABB(ray_start, rd, ray_aabb.xy, ray_aabb.zw);

    if (aabb.x > max_t || aabb.y < 0.0) {
        return false;
    }

    if (aabb.x > 0.0) {
        min_t = aabb.x;
    }
    if (aabb.y < max_t) {
        max_t = aabb.y;
    }

    *ray_interval = vec2f(min_t, max_t);
    return true;
}

#if 0
fn radianceTraceMap(ray_start: vec2f, ray_end: vec2f) -> vec4f {
    const map_bounds = vec4f(0,0,vec2f(map_dim_2d - 1));

    var ray_dir: vec2f;
    var ray_interval: vec2f;
    if (!radiancePrepareTrace(ray_start, ray_end, map_bounds, &ray_dir, &ray_interval)) {
        return vec4f(0,0,0,1);
    }

    var hit = mapGradLowQuality(ray_start);
    var hit_p = ray_start;
    if (hit.z > 0) {
        hit = mapTraceLowQuality(ray_start, ray_dir, ray_interval.x, ray_interval.y);

        if (hit.z < ray_interval.y) {
            hit_p = ray_start + ray_dir * hit.z;
        } else {
            return vec4f(0,0,0,1);
        }
    }

    let radiance = mapGradToRadiance(hit_p, hit).rgb;

#if use_radiance_trace_debug && 1
    radianceTraceDebugRay(
        ray_start + ray_dir * ray_interval.x,
        hit_p,
        radiance.rgb );
#endif
    return vec4f(radiance, 0.0);
}
#else
fn radianceTraceMap(map_start: vec2f, map_end: vec2f) -> vec4f {
    var ray_dir = map_end - map_start;
    let ray_interval = vec2f(0, length(ray_dir));
    ray_dir /= max(M_EPSILON, ray_interval.y);

    var hit = mapGradLowQuality(map_start);
    var hit_p = map_start;
    if (hit.z > 0) {
        hit = mapTraceLowQuality(map_start, ray_dir, ray_interval.x, ray_interval.y);

        hit_p = map_start + ray_dir * hit.z;
        if (hit.z >= ray_interval.y) {
            // Ray escaped without hitting walls - sample virtual floor radiance
            // The floor receives direct lighting even where there are no 2D walls
            let floor_radiance = mapRadianceSample(hit_p);
            return vec4f(0.15 * floor_radiance, 1.0);
        }
    }

    let radiance = mapGradToRadiance(hit_p, hit).rgb;

#if use_radiance_trace_debug && 1
    radianceTraceDebugRay(
        map_start + ray_dir * (ray_interval.x),
        hit_p,
        radiance.rgb );
#endif
    return vec4f(radiance, 0.0);
}
#endif

// Sky integral formula taken from
// Analytic Direct Illumination - Mathis
// https://www.shadertoy.com/view/NttSW7

fn radianceIntegrateSky_(angle: vec2f) -> vec3f {
    // Sky radiance helper function
    let a1 = angle.y;
    let a0 = angle.x;
    let SkyColor = vec3f(0.2,0.5,1.);
    let SunColor = vec3f(1.,0.5,0.1) * 20.;
    let SunA = 5.0;
    let SunS = 64.0;
    let SSunS = sqrt(SunS);
    let ISSunS = 1./SSunS;
    var SI = SkyColor*(a1-a0-0.5*(cos(a1)-cos(a0)));
    SI += SunColor*(atan(SSunS*(SunA-a0))-atan(SSunS*(SunA-a1)))*ISSunS;
    return SI / 6.0;
}

fn radianceIntegrateSky(angle: vec2f) -> vec3f {
    // Integrate the radiance from the sky over an interval of directions
#if 1
    if (angle.y < M_TAU) {
        return radianceIntegrateSky_(angle);
    }
    return
        radianceIntegrateSky_(vec2f(angle.x, M_TAU)) +
        radianceIntegrateSky_(vec2f(0.0, angle.y - M_TAU));
#else
    // Handles wrapping across 2π boundary

    // Ensure angle.x <= angle.y
    let a0 = min(angle.x, angle.y);
    let a1 = max(angle.x, angle.y);

    // If interval doesn't wrap around 2π, simple case
    if (a1 - a0 <= M_PI) {
        return radianceIntegrateSky_(vec2f(a0, a1));
    }

    // Interval wraps: split into two parts
    // Part 1: [a0, 2π]
    // Part 2: [0, a1 - 2π]
    return radianceIntegrateSky_(vec2f(a0, M_TAU)) +
           radianceIntegrateSky_(vec2f(0.0, a1 - M_TAU));
#endif
}

///***************************************************************************
///---------------------------------------------------------------------------
/// Radiance cascades passes
///---------------------------------------------------------------------------
///***************************************************************************

#calcdefine RADIANCE_NUM_CASCADES_M1 (RADIANCE_NUM_CASCADES - 1)


#calcdefine RADIANCE_DISPATCH (MAP_DISPATCH / (1 << use_radiance_cascades_sparseupdate))
#if use_radiance_cascades_sparseupdate
fn cascadeFrameCandidate(id: vec2u) -> vec2u {
    let rnd = createRandom(vec4(id, 11131719, 31333739)).x;
    let off = (rnd + time.frame) % 4u;
    return (id * 2u + vec2(off % 2u, off / 2u));
}
#else
fn cascadeFrameCandidate(id: vec2u) -> vec2u { return id; }
#endif

#workgroup_count pass_radiance_cascade_compute_last RADIANCE_DISPATCH RADIANCE_DISPATCH 1
@compute @workgroup_size(MAP_WORKGROUP, MAP_WORKGROUP)
fn pass_radiance_cascade_compute_last(@builtin(global_invocation_id) gid: vec3u) {
    let id = cascadeFrameCandidate(gid.xy);
    if (all(id.xy < cascade_viewport)) {
        const cascade = RADIANCE_NUM_CASCADES_M1;
        let location = pixelToProbeLocation(id.xy, cascade);
        let radiance = radianceCascadeComputeLast(location);

        let pixel_index = probeLocationToPixelIndex(location);
        game.gi.radiance_cascades[pixel_index] = vec4<f16_or_32>(radiance);
    }
}

#dispatch_count pass_radiance_cascade_compute_others RADIANCE_NUM_CASCADES_M1
#workgroup_count pass_radiance_cascade_compute_others RADIANCE_DISPATCH RADIANCE_DISPATCH 1
@compute @workgroup_size(MAP_WORKGROUP, MAP_WORKGROUP)
fn pass_radiance_cascade_compute_others(@builtin(global_invocation_id) gid: vec3u) {
    let id = cascadeFrameCandidate(gid.xy);
    if (all(id.xy < cascade_viewport)) {
        let cascade = RADIANCE_NUM_CASCADES_M1 - dispatch.id - 1;
        let location = pixelToProbeLocation(id.xy, cascade);
        let radiance = radianceCascadeCompute(location);

        let pixel_index = probeLocationToPixelIndex(location);
        game.gi.radiance_cascades[pixel_index] = vec4<f16_or_32>(radiance);
    }
}

#if use_radiance_cascades_temporal
#workgroup_count pass_radiance_cascade_temporal_accumulation RADIANCE_DISPATCH RADIANCE_DISPATCH 1
@compute @workgroup_size(MAP_WORKGROUP, MAP_WORKGROUP)
fn pass_radiance_cascade_temporal_accumulation(@builtin(global_invocation_id) gid: vec3u) {
    let id = cascadeFrameCandidate(gid.xy);
    if (all(id.xy < cascade_viewport)) {
        const cascade = 0;
        let location = pixelToProbeLocation(id.xy, cascade);
        let pixel_index = probeLocationToPixelIndex(location);

        let radiance_new = vec4f(game.gi.radiance_cascades[pixel_index]);
        let radiance_prv = vec4f(game.gi.temporal_radiance[pixel_index]);

        let adaptation_rate = saturate(exp(-4.0 * time.delta));
        let radiance_accum = mix(radiance_new, radiance_prv, adaptation_rate);

        game.gi.temporal_radiance[pixel_index] = vec4<f16_or_32>(radiance_accum);
    }
}
#endif

#endif //!use_radiance_cascades


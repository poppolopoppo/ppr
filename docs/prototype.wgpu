#else
const liquids_pass_src_2_advect     = 0;
const liquids_pass_src_2_density    = 1;
const liquids_pass_src_2_integrate  = 1;

const liquids_pass_src_3_advect     = 0;
const liquids_pass_src_3_density    = 1;

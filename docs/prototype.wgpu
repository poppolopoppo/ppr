const CH_screenspace_distancefield_cells = 3;

fn mapCellRadiance(map_idx: u32) -> vec3f {
    let cell = map.cells[map_idx];
    let elem = cellElement(cell);

    let mat = game.elements.materials[elem];
    let radiance = mat.emissive + mat.albedo * custom.diffuse_boost;

    return radiance;
}

fn mapGradToRadiance(pos: vec2f, grad: vec4f) -> vec3f {
    let closest_idx = u32(floor(grad.w));
    let cell_pos = vec2i(floor(pos));
    if (mapIsInside(cell_pos)) {
#if use_radiance_cascades_brdf
        return mapDirectLighting(pos);
#else
        if (grad.z < 0) {
            return mapRadianceNearest(cell_pos);
        } else {
            return radianceUnpack(map.radiance[closest_idx]);
        }
#endif
    } else {
        // let angle = 1.0 - atan2(grad.y, grad.x);
        // return radianceIntegrateSky(vec2f(angle-0.5,angle+0.5)).rgb;
        return vec3f(0.0);
    }
}

#if 0  // %NOCOMMIT%
@compute @workgroup_size(16, 16)
fn pass_screenspace_distancefield_cells(@builtin(global_invocation_id) id: vec3u) {
    if (any(vec2i(id.xy) >= vec2i(R))) { return; }

    let frag_coord = vec2f(id.xy) + 0.5;

    var p = cameraTransform(frag_coord);

    let grad = mapGrad(p);

    let hit_p = p + grad.xy * grad.z;
    let hit_fragment = cameraTransformInverse(hit_p);

    let d = /*Linf_*/length(hit_fragment - frag_coord) * sign(grad.z);

    var radiance = mapGradToRadiance(hit_p, grad);

    let screenspace_df = vec4f(radiance, d);
    passStore(CH_screenspace_distancefield_cells, vec2i(id.xy), screenspace_df);
}

fn screenSample(frag_coord: vec2f) -> vec4f {
    let uv = clamp(frag_coord / R.xy, vec2f(0), vec2f(1));
    return passSampleLevelBilinearRepeat(CH_screenspace_distancefield_cells, uv, 0);
}

#define use_screen_trace_debug 0
#if use_screen_trace_debug
var<private> g_enable_screen_trace_debug : bool;
#endif

fn screenTrace(ro: vec2f, rd: vec2f, min_t: f32, max_t: f32) -> vec4f {
    var t = min_t;
    var radiance = vec4f(0,0,0,max_t);

#if use_screen_trace_debug && 1
    if (g_enable_screen_trace_debug) {
        canvasDrawArrow(
            cameraTransform(ro + rd * min_t),
            cameraTransform(ro + rd * max_t),
            2 * canvas.ddxyLen);
    }
#endif

    for (var i = 0; i < 100; i++) {
        let p = ro + rd * t;
        let sc = screenSample(p);

#if use_screen_trace_debug && 1
        if (g_enable_screen_trace_debug) {
            let restore_style = canvas.style;

            // canvas.style.fill = vec4f(0.0);
            // //canvas.style.stroke = vec4f(pastelPalette(f32(i)/32), 1.0);
            // canvas.style.stroke = vec4f(1*heatPalette(0.2 + 0.8 * (f32(i)/32)), 1.0);
            // canvas.style.stroke_width = 1.5;

            // canvasDrawSDF(jfaLength(cameraTransform(p)) - abs(sc.w), canvas.ddxyLen);
            canvas.style.fill = canvas.style.stroke;
            canvasDrawArrow(
                cameraTransform(p),
                cameraTransform(p + rd * abs(sc.w)),
                1.0*game.cam.zoom);

            canvas.style = restore_style;
        }
#endif

        t += abs(sc.w);
        if (abs(sc.w) < 0.001 * t || t > max_t) {
            radiance = select(radiance, vec4(sc.rgb, t), abs(sc.w) < 0.001 * t );
            break;
        }

        t += 0.001 * sc.w;
    }

#if use_screen_trace_debug
    if (g_enable_screen_trace_debug && (radiance.a) < max_t) {
        let restore_style = canvas.style;

        let p = ro + rd * t;
        canvas.style.fill = vec4f(radiance.rgb, 1.0);
        canvas.style.stroke_width = 1.0;
        canvasDrawCircle(cameraTransform(p), 3*game.cam.zoom);

        canvas.style = restore_style;
    }
#endif

    return radiance;
}

fn screenSoftShadow(ro: vec2f, rd: vec2f, min_t: f32, max_t: f32, w: f32, r: f32) -> f32 {
    var res = 1.0;
    var t = min_t;
    for (var i = 0; i < 200 && t < max_t; i++) {
        let h = screenSample(ro + t*rd).w - r;
        res = min( res, h/(w*t) );
        t += clamp(h, 0.05, 5.0);
        if (res<-1.0 || t > max_t) {
            break;
        }
    }
    res = max(res,-1.0);
    return 0.25*(1.0+res)*(1.0+res)*(2.0-res);
}

#endif

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////
//////
////// Rendering of the map & particles (HDR)
//////
//////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////

fn shadeCell(   id: vec2i,
                cell_pos: vec2i,
                view: vec3f,
                geo: Geometry,
                mat: Material ) -> vec3f {
    // canvasInit(p.xy, p_ddx.xy, p_ddy.xy); // #TODO: refactor to not use canvas?
    //let cell = cellRender(p.xy, p_ddx.xy, p_ddy.xy, vec3f(1.0));

    let local_pos = (geo.position - world_bounds_min);

    var ao = worldOcclusionInsideBounds(local_pos, geo.normal, M_EPSILON);
    ao *= saturate(1 - 0.5*exp(-0.5+0.5*sdBox(local_pos.xy - vec2f(cell_pos) - 0.5, vec2f(0.5))));

    var actual_geo = geo;
    actual_geo.position = local_pos;
    actual_geo.bent_normal = worldBentNormalInsideBounds(local_pos, geo.normal, ddxyLen3(geo.ddx, geo.ddy));

    var col = vec3f(0);
    col += lightingDirect(id, view, actual_geo, mat);
    col += ao * lightingIndirect(id, view, actual_geo, mat);

    var overlay = gameOverlayColor(cell_pos);
    overlay = vec4f(ao * overlay.rgb / map.exposure.scale, overlay.a);

    let grid_d = sdBox(local_pos.xy - vec2f(cell_pos) - 0.5, vec2f(0.5));
    let overlay_width = select(3.0, mix(8,16,cos(time.elapsed*M_TAU)*0.5+0.5), all(cell_pos == game.mouse_cell_pos));
    overlay.a *= smoothstep(overlay_width, overlay_width * 0.5, abs(grid_d/ddxyLen2(geo.ddx.xy, geo.ddy.xy)));
    col = alphaBlend(overlay, vec4f(col, 1.0)).rgb;

    return col;
}

fn cellTriplanarTexture(cell: PackedMapCell, geo: ptr<function, Geometry>, mat: ptr<function, Material>) {
    let elem = cellElement(cell);

    let tiling = 32.0;

    var rng = createRandom(vec4(elem));
    let offset = f32(randI32(&rng, 0, 16)) * tiling;

    var w = normalize((abs(geo.normal)+M_EPSILON));

    let tex_p = (geo.position - world_bounds_min) * tiling + offset;
    let tex_ddx = geo.ddx * tiling;
    let tex_ddy = geo.ddy * tiling;

    let ns = vec4f(sign(geo.normal), 1);

    let r = 2.0 * sqr(mat.roughness);
    let x = filteredXorGradSoft(tex_p.zy * ns.xw, tex_ddx.zy * ns.xw, tex_ddy.zy * ns.xw, r);
    let y = filteredXorGradSoft(tex_p.xz * ns.yw, tex_ddx.xz * ns.yw, tex_ddy.xz * ns.yw, r);
    let z = filteredXorGradSoft(tex_p.xy * ns.zw, tex_ddx.xy * ns.zw, tex_ddy.xy * ns.zw, r);

    let tex_grad = x * w.x + y * w.y + z * w.z;

    mat.albedo *= mix(0.8, 1.0, tex_grad.z);

    let tn = normalize(vec3(tex_grad.xy, 2.0));

    geo.normal = normalize(
        geo.tangent * tn.x +
        geo.binormal * tn.y +
        geo.normal * tn.z);
    //mat.metallic = 0.5;
    mat.roughness = mix(mat.roughness, tex_grad.z, 0.1);
}

#if 1
@compute @workgroup_size(16, 16)
fn pass_render_opaque(@builtin(global_invocation_id) id: vec3u) {
    if (any(vec2i(id.xy) >= vec2i(R))) { return; }

    var frag_coord = vec2f(id.xy) + 0.5;
    let taa_offset = taaFragmentOffset(time.frame);
    frag_coord += taa_offset;

    var ddx_eye: Ray3f;
    var ddy_eye: Ray3f;
    let eye = cameraWorldRayDdxDdy(game.cam.model, frag_coord, &ddx_eye, &ddy_eye);

    var world_hit = worldTrace(eye);

    var col: vec3f;
    if (world_hit.y >= 0) {
        // --- Map cells ---
        var geo = worldHitToGeometry(eye, ddx_eye, ddy_eye, world_hit);
        var mat = Material(vec3f(M_PI), 0.0, 0.2, vec3f(0.0), vec3f(0.0), vec3f(0.0));
        var cell_pos: vec2i;

        if (world_hit.y > 0) {
            let cell_index = u32(floor(world_hit.z));
            var cell = map.cells[cell_index];
            cell_pos = mapIndexToPos(u32(cell_index));

            if (!cellIsInterior(cell)) {
                let map_pos = geo.position.xy - world_bounds_min.xy;
                cell_pos = vec2i(floor(map_pos));
                cell = cellLoad(cell_pos);

                if (!cellIsInterior(cell)) {
                    let map_grad = mapGrad(map_pos);
                    let map_idx = u32(floor(map_grad.w));
                    cell = map.cells[map_idx];
                    cell_pos = mapIndexToPos(map_idx);
                }
            }

            mat = cellMaterial(cell);
        #if 1
            cellTriplanarTexture(cell, &geo, &mat);
        #endif

            if (!cellIsInterior(cell)) {
                mat.albedo = errorPalette() * M_PI;
            }

        } else {
            let tex_tile = 8.0;
            let tex_grad = filteredXorGradSoft(geo.position.xy * tex_tile, geo.ddx.xy * tex_tile, geo.ddy.xy * tex_tile, 0.1);
            mat.albedo *= mix(0.2, 0.3, tex_grad.z);
            mat.metallic = 0.0;
            mat.roughness = tex_grad.z;
            geo.normal = normalize(vec3f(tex_grad.xy, 20.0));

            cell_pos = vec2i(floor(geo.position.xy - world_bounds_min.xy));
        }

        col = shadeCell(vec2i(id.xy), cell_pos, eye.dir, geo, mat);

    } else {
        // --- Outer background ---

        world_hit.x = worldOuterBackgroundIntersect(eye, 30.0);

        let geo = worldHitToGeometry(eye, ddx_eye, ddy_eye, world_hit);

        const checker_tile = 8.0;
        let checker = filteredXor(  geo.position.xy * checker_tile,
                                    geo.ddx.xy * checker_tile,
                                    geo.ddy.xy * checker_tile);

        col = mix(vec3f(.1), vec3f(.13), checker);
    }

    let depth = world_hit.x;

    // Only apply fog to the inner world, not the outer background
    if (world_hit.y >= 0) {
        let fog = exponentialFog(vec2i(id.xy), eye, depth);
        col = mix(col, fog.rgb, fog.a);
    }

    // --- Final base-pass output ---
    // NaN safety check: replace invalid values with error color for debugging
    col = select(col, errorPalette(), isNaN3(col));
    passStore(CH_screenspace_distancefield_cells, vec2i(id.xy), vec4f(col, depth));
}
#endif

fn reconstructPosition(frag_coord: vec2f, cam: CameraModel, depth: f32) -> vec3f {
    let eye = cameraWorldRay(cam, frag_coord);
    return eye.org + eye.dir * depth;
}

fn reconstructOpaquePosition(frag_coord: vec2f) -> vec3f {
    let depth = passLoad(CH_screenspace_distancefield_cells, vec2i(frag_coord.xy), 0).a;
    return reconstructPosition(frag_coord, game.cam.model, depth);
}

#if use_particle_simulation
@compute @workgroup_size(16, 16)
fn pass_render_translucency(@builtin(global_invocation_id) id: vec3u) {
    if (any(vec2i(id.xy) >= vec2i(R))) { return; }

    var frag_coord = vec2f(id.xy) + 0.5;
    let taa_offset = taaFragmentOffset(time.frame);
    frag_coord += taa_offset;

    // Reconstruct World Position
    var ddx_eye: Ray3f;
    var ddy_eye: Ray3f;
    let eye = cameraWorldRayDdxDdy(game.cam.model, frag_coord, &ddx_eye, &ddy_eye);

    // Read Background
    let background = passLoad(CH_screenspace_distancefield_cells, vec2i(id.xy), 0);

    // Trace Liquid
    var liq_hit: f32;

    var translucent = background;

    if (liquidsTraceWorld(eye, background.a, &liq_hit)) {
        // Shading
        let liquids = liquidsShading(frag_coord, eye, ddx_eye, ddy_eye, liq_hit);

        // For TAA to work correctly on the liquid surface, we must write the liquid depth.
        // We need distance from camera to liquid surface.
        // translucent = vec4f(alphaBlend(vec4f(background.rgb,1), liquids).rgb, background.a);
        translucent = vec4f(vec3f(liquids.rgb), liq_hit);
    }

    // Com
    passStore(CH_screenspace_distancefield_cells, vec2i(id.xy), translucent);
}
#endif


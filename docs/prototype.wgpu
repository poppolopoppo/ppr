///***************************************************************************
///---------------------------------------------------------------------------
/// Auto-exposure
///---------------------------------------------------------------------------
///***************************************************************************

// https://bruop.github.io/exposure/

#define use_auto_exposure 1

#define use_auto_exposure_colors 1

#define EXPOSURE_HISTOGRAM_WORKGROUP 16
#calcdefine EXPOSURE_HISTOGRAM_NUM_BINS (EXPOSURE_HISTOGRAM_WORKGROUP * EXPOSURE_HISTOGRAM_WORKGROUP)

alias LuminanceLocalHistogram = array<u32, EXPOSURE_HISTOGRAM_NUM_BINS>;
alias LuminanceSharedHistogram = array<atomic<u32>, EXPOSURE_HISTOGRAM_NUM_BINS>;

#if use_auto_exposure_colors
alias ColorLocalHistogram = array<LuminanceLocalHistogram, 3>;
alias ColorSharedHistogram = array<LuminanceSharedHistogram, 3>;
#endif

struct AutoExposure {
    scale: f32,
    average: f32,

    prev_scale: f32,
    prev_average: f32,

    min_log: f32,
    log_range: f32,
    inverse_log_range: f32,

    histogram: LuminanceSharedHistogram,
    last_histogram: LuminanceLocalHistogram,

#if use_auto_exposure_colors
    color_spectrum: ColorSharedHistogram,
    last_color_spectrum: ColorLocalHistogram,
#endif
};

fn exposureUpdate() {
    map.exposure.min_log = log2(custom.exposure_min + M_EPSILON);
    map.exposure.log_range =  log2(custom.exposure_max + M_EPSILON) - map.exposure.min_log;
    map.exposure.inverse_log_range = 1.0 / max(map.exposure.log_range, M_EPSILON);

#if use_auto_exposure
    if (time.frame == 0u)
#endif
    {
        map.exposure.scale = 1.0;
        map.exposure.average = 1.0;
    }

    map.exposure.prev_average = map.exposure.average;
    map.exposure.prev_scale = map.exposure.scale;
}

var<workgroup> s_exposure_shared_histogram: LuminanceSharedHistogram;

#if use_auto_exposure_colors
var<workgroup> s_exposure_shared_color_spectrum: ColorSharedHistogram;
#endif

// For a given color and luminance range, return the histogram bin index
fn exposureLuminanceToBin(lum: f32, min_log: f32, inverse_log_range: f32) -> u32 {
    // Avoid taking the log of zero
    if (lum < M_EPSILON) {
        return 0u;
    }

    // Calculate the log_2 luminance and express it as a value in [0.0, 1.0]
    // where 0.0 represents the minimum luminance, and 1.0 represents the max.
    let logLum = saturate((log2(lum) - min_log) * inverse_log_range);

    // Map [0, 1] to [1, 255]. The zeroth bin is handled by the epsilon check above.
    return clamp(uint(logLum * f32(EXPOSURE_HISTOGRAM_NUM_BINS - 2) + 1.0), 0u, EXPOSURE_HISTOGRAM_NUM_BINS - 1);
}

fn exposureColorToBin(hdr_color: vec3f, min_log: f32, inverse_log_range: f32) -> u32 {
    // Convert our RGB value to Luminance
    let lum = rgbToLuminance(hdr_color);
    return exposureLuminanceToBin(lum, min_log, inverse_log_range);
}

#if use_auto_exposure
@compute @workgroup_size(EXPOSURE_HISTOGRAM_WORKGROUP, EXPOSURE_HISTOGRAM_WORKGROUP)
fn pass_exposure_luma_histogram(@builtin(global_invocation_id) id: vec3u,
                                @builtin(local_invocation_index) local_idx: u32) {
    // Initialize the bin for this thread to 0
    atomicStore(&s_exposure_shared_histogram[local_idx], 0u);
    workgroupBarrier();

    // Ignore threads that map to areas beyond the bounds of our HDR image
    if (any(vec2i(id.xy) < vec2i(R))) {
        let hdr_color = passLoad(CH_screenspace_distancefield_cells, vec2i(id.xy), 0).rgb;
        let bin_idx = exposureColorToBin(hdr_color, map.exposure.min_log, map.exposure.inverse_log_range);

        // We use an atomic add to ensure we don't write to the same bin in our
        // histogram from two different threads at the same time.
        atomicAdd(&s_exposure_shared_histogram[bin_idx], 1);

#if use_auto_exposure_colors
        for (var c = 0; c < 3; c++) {
            let bin_idx = exposureLuminanceToBin(hdr_color[c], map.exposure.min_log, map.exposure.inverse_log_range);
            atomicAdd(&s_exposure_shared_color_spectrum[c][bin_idx], 1);
        }
#endif
    }

    // Wait for all threads in the work group to reach this point before adding our
    // local histogram to the global one
    workgroupBarrier();

    // Technically there's no chance that two threads write to the same bin here,
    // but different work groups might! So we still need the atomic add.
    atomicAdd(&map.exposure.histogram[local_idx],
        atomicLoad(&s_exposure_shared_histogram[local_idx]));

#if use_auto_exposure_colors
    for (var c = 0; c < 3; c++) {
        atomicAdd(&map.exposure.color_spectrum[c][local_idx],
                atomicLoad(&s_exposure_shared_color_spectrum[c][local_idx]));
    }
#endif
}

var<workgroup> s_exposure_local_histogram: LuminanceLocalHistogram;

#if use_auto_exposure_colors
var<workgroup> s_exposure_local_color_spectrum: ColorLocalHistogram;
#endif

#workgroup_count pass_exposure_average_luma 1 1 1
@compute @workgroup_size(EXPOSURE_HISTOGRAM_NUM_BINS, 1)
fn pass_exposure_average_luma(@builtin(local_invocation_index) local_idx: u32) {
    // Get the count from the histogram buffer
    let count_for_this_bin = atomicLoad(&map.exposure.histogram[local_idx]);
    s_exposure_local_histogram[local_idx] = count_for_this_bin * local_idx;

#if use_auto_exposure_colors
    var colors_count_for_this_bin = vec3u(0);
    for (var c = 0; c < 3; c++) {
        colors_count_for_this_bin[c] = atomicLoad(&map.exposure.color_spectrum[c][local_idx]);
        s_exposure_local_color_spectrum[c][local_idx] = colors_count_for_this_bin[c] * local_idx;
    }
#endif

    workgroupBarrier();

    // Reset the count stored in the buffer in anticipation of the next pass
    map.exposure.last_histogram[local_idx] = count_for_this_bin;
    atomicStore(&map.exposure.histogram[local_idx], 0);

#if use_auto_exposure_colors
    for (var c = 0; c < 3; c++) {
        map.exposure.last_color_spectrum[c][local_idx] = colors_count_for_this_bin[c];
        atomicStore(&map.exposure.color_spectrum[c][local_idx], 0);
    }
#endif

    // This loop will perform a weighted count of the luminance range
    for (var cut_off: u32 = (EXPOSURE_HISTOGRAM_NUM_BINS >> 1u); cut_off > 0u; cut_off >>= 1u) {
        if (local_idx < cut_off) {
            s_exposure_local_histogram[local_idx] += s_exposure_local_histogram[cut_off + local_idx];
        }

        workgroupBarrier();
    }

    // We only need to calculate this once, so only a single thread is needed.
    if (local_idx == 0u) {
        const pixels_num = SCREEN_WIDTH * SCREEN_HEIGHT;
        // Here we take our weighted sum and divide it by the number of pixels
        // that had luminance greater than zero (since the index == 0, we can
        // use count_for_this_bin to find the number of black pixels)
        let weighted_log_avg = clamp((f32(s_exposure_local_histogram[0]) / f32(max(pixels_num - count_for_this_bin, 1))) - 1.0, 0.0, EXPOSURE_HISTOGRAM_NUM_BINS - 2);

        // Map from our histogram space to actual luminance
        let weighed_avg_luma = exp2(((weighted_log_avg / f32(EXPOSURE_HISTOGRAM_NUM_BINS - 2)) * map.exposure.log_range) + map.exposure.min_log);

        if (time.frame < 3) {
            map.exposure.average = weighed_avg_luma;

        } else {
            // The new stored value will be interpolated using the last frames value
            // to prevent sudden shifts in the exposure.
            let luma_last_frame = map.exposure.average;
            let adaptation_rate = saturate(1.0 - exp(-5.0 * max(M_EPSILON, custom.exposure_speed) * time.delta));
            let luma_adapted = mix(luma_last_frame, weighed_avg_luma, adaptation_rate);

            map.exposure.average = luma_adapted;
        }

        // Compute final exposure scaling factor from EV100 and camera settings (hard-coded here)
        const S = 100.0;    // sensor sentivity
        const K = 12.5;     // reflected-light meter calibration constant
        const q = 0.65;     // lens and vignetting attenuation

        let ev100 = log2(map.exposure.average * (S/K) + M_EPSILON);
        let l_max = (78 / (q * S)) * pow(2.0, ev100);
        map.exposure.scale = select(1.0, 1.0 / l_max, l_max > M_EPSILON);
    }
}
#endif

// Computes the camera's EV100 from exposure settings
// aperture in f-stops
// shutterSpeed in seconds
// sensitivity in ISO
//
// https://google.github.io/filament/Filament.md.html
fn exposureSettings(aperture: f32, shutterSpeed: f32, sensitivity: f32) -> f32 {
    return log2((aperture * aperture) / shutterSpeed * 100.0 / sensitivity);
}

// Computes the exposure normalization factor from
// the camera's EV100
//
// https://google.github.io/filament/Filament.md.html
fn exposureFromSettings(ev100: f32) -> f32 {
    return 1.0 / (pow(2.0, ev100) * 1.2);
}

fn exposureHistogramWidget(frag_coord: vec2f, bounds: vec4f) {
    let box_extent = max(bounds.zw - bounds.xy, vec2f(0));
    let box_center = (bounds.xy + bounds.zw) / 2;

    const num_bins_oo = 1.0 / f32(EXPOSURE_HISTOGRAM_NUM_BINS);
    const num_pixels_oo = 1.0 / f32(SCREEN_WIDTH * SCREEN_HEIGHT);
    const log_num_pixels_oo = 1.0 / log2(f32(SCREEN_WIDTH * SCREEN_HEIGHT));

    let restore_style = canvas.style;

    canvas.style.stroke_width = 2;
    canvas.style.fill.a = 0.1;

    canvasDrawSDF(sdBox(frag_coord - box_center, box_extent * 0.5), 1.0);

    canvas.style.fill.a = 0.5;
    canvas.style.glow_width = 0;
    canvas.style.stroke_width = 0;

    if (all((frag_coord >= bounds.xy) & (frag_coord < bounds.zw))) {
        let bounds_uv = (frag_coord.xy - bounds.xy) / (bounds.zw - bounds.xy);
        let bin_min_index = u32(max(floor(bounds_uv.x * EXPOSURE_HISTOGRAM_NUM_BINS) - 1, 0));
        let bin_max_index = min(bin_min_index + 2u, EXPOSURE_HISTOGRAM_NUM_BINS - 1);
        // for (var i = 0u; i < EXPOSURE_HISTOGRAM_NUM_BINS; i++) {
        for (var i = bin_min_index; i <= bin_max_index; i++) {
            let u = (f32(i) + 0.5) * num_bins_oo;
            // var v = f32(map.exposure.last_histogram[i]) * num_pixels_oo;
            let v = log2(f32(map.exposure.last_histogram[i]) + M_EPSILON) * log_num_pixels_oo;

            let exposure = exp2(u * map.exposure.log_range + map.exposure.min_log);

            var fill = vec3f(1.0);
#if use_auto_exposure_colors
            let color_v = vec3f(
                f32(map.exposure.last_color_spectrum[0][i]) + M_EPSILON,
                f32(map.exposure.last_color_spectrum[1][i]) + M_EPSILON,
                f32(map.exposure.last_color_spectrum[2][i]) + M_EPSILON );
            //color_v = normalize(color_v);
            let normalized_color_v = normalize(log2(color_v));
            fill = normalized_color_v;
#endif

            fill *= exposure;
            // fill = tonemapAGX(fill, agx_look_default);
            fill = tanh(fill);

            canvas.style.fill = vec4f(fill, canvas.style.fill.a);

            let bar_min = bounds.xy + vec2f(u - 0.5 * num_bins_oo, 0.0) * box_extent;
            let bar_max = bounds.xy + vec2f(u + 0.5 * num_bins_oo, v) * box_extent;
            let bar_extent = bar_max - bar_min;
            let bar_center = (bar_max + bar_min) / 2;

            canvasDrawSDF(sdBox(frag_coord - bar_center, bar_extent * 0.5), 1.0);

#if use_auto_exposure_colors
            for (var c = 0; c < 3; c++) {
                let graph_pos = bounds.xy + vec2f(u, log2(color_v[c]) * log_num_pixels_oo) * box_extent;

                var spectrum_col = vec3f(0);
                spectrum_col[c] = exposure;
                canvas.style.fill = vec4f(tanh(spectrum_col), canvas.style.fill.a);
                let line_extent = vec2(0.5 * num_bins_oo * box_extent.x, 0.0);

                canvasDrawSDF(sdSegment(frag_coord.xy, graph_pos - line_extent, graph_pos + line_extent) - 0.25*line_extent.x, 1.0);
            }
#endif
        }
        {
            // Map from our histogram space to actual luminance

        // let weighed_avg_luma = exp2(((weighted_log_avg / f32(EXPOSURE_HISTOGRAM_NUM_BINS - 2)) * map.exposure.log_range) + map.exposure.min_log);
            let f = saturate((log2(map.exposure.average) - map.exposure.min_log) * map.exposure.inverse_log_range);
            let i = 1u + u32(f32(EXPOSURE_HISTOGRAM_NUM_BINS - 2) * f);
            let u = (f32(i) + 0.5) * num_bins_oo;
            // var v = f32(map.exposure.last_histogram[i]) * num_pixels_oo;
            let v = 1.0;

            //   v = cos(u * M_TAU + time.elapsed) * 0.5 + 0.5;

            canvas.style.fill = vec4f(0,1,0,1);
            canvas.style.glow_width = 2;

            let bar_min = bounds.xy + vec2f(u - 0.5 * num_bins_oo, 0.0) * box_extent;
            let bar_max = bounds.xy + vec2f(u + 0.5 * num_bins_oo, v) * box_extent;
            let bar_extent = bar_max - bar_min;
            let bar_center = (bar_max + bar_min) / 2;

            canvasDrawSDF(sdBox(frag_coord - bar_center, bar_extent * 0.5), 1.0);
        }
    }
}

///***************************************************************************
///---------------------------------------------------------------------------
/// Temporal AA with neighborhood variance clamping
///---------------------------------------------------------------------------
///***************************************************************************

#define use_temporal_aa 1

#if use_temporal_aa
const CH_TAA_history_buffer = 1;

fn taaFragmentOffset(frame: u32) -> vec2f {
#if 0
    // 2D low discrepancy noise
    const c_rho_1 = (
        2.0 * cosh(acosh(3.0 * sqrt(3.0) / 2.0) / 3.0) / sqrt(3.0)
    );

    const c_rho_2 = c_rho_1 * c_rho_1;
    const c_rho = vec2(c_rho_1, c_rho_2);
    const c_inv_rho = vec2(1.0) / c_rho;

    let x = f32(frame) * c_inv_rho;
    return (fract(x) - 0.5);
#else
    // 2D halton sequence
    let x = halton(time.frame % 8);
    return (fract(x) - 0.5);
#endif
}

struct ColorRange {
    vmin: vec3f,
    vmax: vec3f,
    vavg: vec3f,
    vstd: vec3f,
};

const color_range_min_std = 1.0 / 16.0;
const color_range_min_var = color_range_min_std * color_range_min_std;

#if 0
fn taaColorSpaceFrom(linear: vec3f) -> vec3f {
    return linearToOklab(linear);
}
fn taaColorSpaceTo(ok_lab: vec3f) -> vec3f {
    return okabToLinear(ok_lab);
}
#else
fn taaColorSpaceFrom(linear: vec3f) -> vec3f {
    return RGBToYCoCg(linear);
}
fn taaColorSpaceTo(ok_lab: vec3f) -> vec3f {
    return YCoCgToRGB(ok_lab);
}
#endif

fn colorRangeClamp(color: vec3f, range: ColorRange) -> vec3f {
    return taaColorSpaceTo(clamp(
        taaColorSpaceFrom(color),
        range.vmin, range.vmax ));
}

fn varianceRangeToRange(lhs: ColorRange, rhs: ColorRange) -> f32 {
    let vstd = 1.0 / ((1.0 / lhs.vstd) + (1.0 / rhs.vstd));
    let diff = lhs.vavg - rhs.vavg;
    let variance = (color_range_min_var + diff * diff) / max(vstd * vstd, vec3f(M_EPSILON));
    return length(variance / 4.0);
}

fn colorRangeSample(channel: i32, uv: vec2f, texel: vec2f, exposure: f32) -> ColorRange {
    var min_color = vec3f(FLT_MAX);
    var max_color = vec3f(-FLT_MAX);

    var total = 0.0;
    var L1_color = vec3f(0.0);
    var L2_color = vec3f(0.0);

    for (var y = -1; y <= 1; y++) {
    for (var x = -1; x <= 1; x++) {
        var s = passSampleLevelBilinearRepeat(channel, uv + texel * vec2f(vec2(x, y)), 0.0).rgb;
        s *= exposure;
        s = taaColorSpaceFrom(s);

        min_color = min(min_color, s);
        max_color = max(max_color, s);

        let w = 2.0 / f32(1.0 + f32(abs(x) + abs(y)));
        total += w;
        L1_color += w * s;
        L2_color += w * s * s;
    }}

    L1_color /= total;
    L2_color /= total;

    return ColorRange(min_color, max_color, L1_color,
        sqrt(color_range_min_var + L2_color - L1_color * L1_color));
}

@compute @workgroup_size(16, 16)
fn pass_postprocess_taa(@builtin(global_invocation_id) id: vec3u) {
    const texel = 1.0 / R;

    let next_frag_coord = vec2f(id.xy) + 0.5;
    let next_uv = next_frag_coord * texel;
    let next_sp = passLoad(CH_screenspace_distancefield_cells, vec2i(id.xy), 0);
    let next_depth = next_sp.a;

    // Reconstruct world position with jitter
    let eye = cameraWorldRay(game.cam.model, next_frag_coord + taaFragmentOffset(time.frame));
    let p = eye.org + eye.dir * next_depth;

    // Reproject to previous frame
    let prev_screen_pos = cameraWorldToScreen(game.cam.prev_model, p);
    let prev_frag_coord = prev_screen_pos.xy;
    let prev_depth_reprojected = prev_screen_pos.z; // Depth of current pixel in previous frame
    let prev_uv = prev_frag_coord * texel;

    // --- Disocclusion Detection ---

    // Check if reprojection is off-screen
    let off_screen = any(prev_uv < vec2f(0.0)) || any(prev_uv > vec2f(1.0));

    // Sample previous frame
    let prev_sp = passSampleLevelBilinearRepeat(CH_TAA_history_buffer, prev_uv, 0);
    let prev_depth_stored = prev_sp.a;

    // Depth-based disocclusion test
    // Compare the reprojected depth with what was stored in the history buffer
    // If they differ significantly, we have disocclusion (new geometry revealed)
    let depth_threshold = 0.03 * next_depth; // 3% of current depth
    let depth_diff = abs(prev_depth_reprojected - prev_depth_stored);
    let depth_disoccluded = depth_diff > depth_threshold;

    // Combine disocclusion factors
    let disoccluded = off_screen || depth_disoccluded;

    // --- Color Processing ---

    let next_exposure = map.exposure.scale;
    var next_color = next_sp.rgb * next_exposure;

    let prev_exposure = map.exposure.scale / max(M_EPSILON, map.exposure.prev_scale);
    var prev_color = prev_sp.rgb * prev_exposure;

    // Sample neighborhood for variance clipping
    let next_range = colorRangeSample(CH_screenspace_distancefield_cells, next_uv, texel, next_exposure);
    let prev_range = colorRangeSample(CH_TAA_history_buffer, prev_uv, texel, prev_exposure);

    // Clamp history to reduce ghosting
    prev_color = colorRangeClamp(prev_color, next_range);

    // --- Adaptive Blending ---

    // Base blend factor from variance
    let variance = varianceRangeToRange(next_range, prev_range);
    var blend_factor = 1.0 - exp(-10.0 * custom.taa_adaptation_rate * time.delta * variance);

    // Increase blend on disocclusion (favor current frame)
    blend_factor = select(blend_factor, 1.0, disoccluded);

    // Increase blend on high velocity (reduces ghosting on fast motion)
    let velocity_screen = length(prev_frag_coord - next_frag_coord);
    let velocity_factor = saturate(velocity_screen * 0.1); // Tune multiplier as needed
    blend_factor = max(blend_factor, velocity_factor);

    // Clamp to prevent over-accumulation
    blend_factor = clamp(blend_factor, 0.05, 1.0); // Minimum 5% ensures some temporal filtering

    var accumulated = mix(prev_color, next_color, blend_factor);

#if 0
    if (disoccluded) {
        accumulated = errorPalette() * fract(abs(prev_depth_reprojected - prev_depth_stored) * M_PI);
        if (next_frag_coord.y > R_halfRes.y) {
            if (next_frag_coord.x > R_halfRes.x/2) {
                accumulated = pastelPalette(fract(prev_depth_reprojected * M_PI + time.elapsed));
            } else {
                accumulated = pastelPalette(fract(prev_depth_stored * M_PI + time.elapsed));
            }
        }

    }
#endif

    let next_depth_reprojected = cameraWorldToScreen(game.cam.model, p).z;

    passStore(CH_TAA_history_buffer, vec2i(id.xy), vec4(accumulated, next_depth_reprojected));
}
#else

fn taaFragmentOffset(frame: u32) -> vec2f {
    return vec2f(0.0);
}
#endif //!use_temporal_aa


///***************************************************************************
///---------------------------------------------------------------------------
/// Post-Processs parameters
///---------------------------------------------------------------------------
///***************************************************************************

struct PostProcess {
    bloom: Bloom,
};

///***************************************************************************
///---------------------------------------------------------------------------
/// Fog
///---------------------------------------------------------------------------
///***************************************************************************

#define use_postprocess_exponentialfog (use_hq_rendering && 1)
#define use_exponentialfog_gases 0
#define use_exponentialfog_noise 0

fn cub2(x: vec2f) -> vec2f {
    return x * x * x;
}

fn exponentialFog(id: vec2i, eye: Ray3f, depth: f32) -> vec4f {
#if use_postprocess_exponentialfog

    const num_samples = 8;

    // Find intersection with world bounds to limit fog to inside the world
    var bounds_hit: vec2f;
    var bounds_normal: vec3f;
    let hits_bounds = worldInnerBoundsIntersect(eye, &bounds_hit, &bounds_normal);

    // If ray doesn't intersect world bounds, no fog
    if (!hits_bounds || bounds_hit.x >= depth) {
        return vec4f(0.0);
    }

    // Get ray start and end points (clipped to world bounds)
    let t_start = max(bounds_hit.x, 0.0); // Don't go behind camera
    let t_end = min(bounds_hit.y, depth);
    let ray_length = t_end - t_start;

    // If no valid ray segment inside bounds, no fog
    if (ray_length <= 0.0 ||
        eye.org.z + eye.dir.z * depth < world_bounds_min.z - M_EPSILON) {
        return vec4f(0.0);
    }

    // Fallback fog parameters (used if no gas cells are found)
    let fallback_absorption_coeff = custom.fog_absorption_coeff;
    let fallback_scattering_coeff = custom.fog_scattering_coeff;
    let fallback_extinction_coeff = fallback_absorption_coeff + fallback_scattering_coeff;
    let fog_ambient = vec3f(0.05, 0.08, 0.09); // Increased ambient for better visibility

    // Phase function approximation (simplified Henyey-Greenstein)
    let phase_g = 0.0; // Isotropic scattering
    let phase = 1.0 / (4.0 * M_PI); // Uniform phase function

    var accumulated_scattering = vec3f(0.0);
    var accumulated_transmittance = 1.0;

    let wind_direction = normalize(vec3f(0.1, 0.3,-0.7)); // Wind direction (can be made configurable)

    // Sample along the ray using Beer-Lambert law
    for (var i = 0; i < num_samples; i++) {
        let t = (f32(i) + 0.5) / f32(num_samples);
        let sample_t = mix(t_start, t_end, t);
        let sample_pos = eye.org + eye.dir * sample_t;
        let local_p = (sample_pos.xy - world_bounds_min.xy);

        // let jitter = vec2f(
        //     randTriangular01(&rng),
        //     randTriangular01(&rng) );


        //let jitter = hashBlueNoise4(local_p / game.cam.zoom, vec2f(f32(time.frame), time.elapsed)).xy;
        let jitter = textureSampleLevel(channel0, bilinear_repeat, game.frame_seed.xy + local_p / game.cam.zoom, 0.0).xy;

        let jitter_local_p = local_p + (jitter.xy * 2 - 1) * (0.5 + smoothstep(world_bounds_max.z, world_bounds_min.z, sample_pos.z)) * M_PI;

#if use_exponentialfog_gases
        // Early cell sampling and phase check for quick rejection
        var cell = cell_VACUUM;
        if (all(jitter_local_p.xy >= vec2f(0.0)) && all(jitter_local_p.xy < vec2f(map_dim_2d.xy))) {
            cell = cellLoad(vec2i(floor(jitter_local_p.xy)));
        }

        // // Quick rejection: Skip if VACUUM or not gas phase (before expensive operations)
        // // For out-of-bounds, cellPhase returns phase_SOLID (via cell_VACUUM), ensuring rejection
        // if (cell == cell_VACUUM || cellPhase(cell) != phase_GAS) {
        //     // Skip all expensive operations for non-gas/vacuum cells
        //     continue;
        // }

        // Only process gas cells: retrieve material properties
        let mat = cellMaterial(cell);
        let cell_mass = f32(cellMass(cell));

        // Use material's volumetric properties instead of global constants
        let absorption_coeff = mat.absorption;
        let scattering_coeff = mat.scattering;
        let volumetric_color = mat.albedo; // Use albedo as volumetric color

        // Scale absorption/scattering by cell mass to represent gas density
        // Denser gas cells (higher mass) absorb and scatter more light
        // Normalize mass relative to typical gas range (50-500) for better scaling
        let gas_mass_min = 50.0;
        let gas_mass_max = 500.0;
        let mass_normalized = saturate((cell_mass - gas_mass_min) / (gas_mass_max - gas_mass_min)); // 0.0 to 1.0 for typical gas range
        // Use a power curve to make density differences visible: denser = more absorption
        // Scale up the base to ensure visibility even at low mass
        let density_factor = mix(0.08, 2.0, pow(mass_normalized, 0.6)); // Scale from 0.3x to 1.5x for visibility

        // Global scale factor to make fog visible (gas coefficients are quite small)
        let fog_scale = 10.0; // Scale up volumetric coefficients for visibility

        // Scale absorption/scattering by density factor and global scale
        // Higher mass = higher density = more absorption and scattering
        let local_absorption = absorption_coeff * density_factor * fog_scale;
        let local_scattering = scattering_coeff * density_factor * fog_scale;
        let local_extinction = local_absorption + local_scattering;
#else
        let local_absorption = fallback_absorption_coeff;
        let local_scattering = fallback_scattering_coeff;
        let local_extinction = local_absorption + local_scattering;
        let volumetric_color = vec3f(.8);
#endif

#if use_exponentialfog_noise
        // Simple volumetric fog density variation (for noise)
        let noise_pos = sample_pos * custom.fog_noise_scale;
        let wind_speed = custom.fog_wind_speed;
        let density_noise = vec3(0,0,animatedFbmNoise3D(noise_pos, time.elapsed, wind_direction, wind_speed, 3));
        let density_variation = mix(0.02, 1.0, density_noise.z); // Moderate variation

        // Use simple z-up normal (efficient and stable)
        let fog_normal = normalize(vec3f(density_noise.xy, 1));
#else
        let density_variation = 1.0;
        let fog_normal = vec3f(0, 0, 1);
#endif

        // Sample radiance for in-scattering
        let scattered_radiance = cascadeIrradiance(jitter_local_p.xy, fog_normal, false);

        // Calculate transmittance from camera to this sample point
        let optical_depth_to_sample = local_extinction * density_variation * (sample_t - t_start);
        let transmittance_to_sample = exp(-optical_depth_to_sample);

        // In-scattering contribution: radiance * transmittance * phase * scattering_coeff * ds * density
        let ds = ray_length / f32(num_samples);
        let local_scattering_coeff = local_scattering * density_variation;
        let in_scattering = (scattered_radiance * transmittance_to_sample) * phase * local_scattering_coeff * ds;

        // Apply volumetric color tint
        let in_scattering_tinted = in_scattering * volumetric_color;

        accumulated_scattering += in_scattering_tinted;

        // Update transmittance for next sample (Beer-Lambert with density variation)
        let optical_depth_segment = local_extinction * density_variation * ds;
        accumulated_transmittance *= exp(-optical_depth_segment);
    }

    // Return fog color and opacity (1 - transmittance through entire volume)
    let fog_opacity = 1.0 - accumulated_transmittance;
    return vec4f(accumulated_scattering, fog_opacity);
#else
    return vec4f(0);
#endif
}

///***************************************************************************
///---------------------------------------------------------------------------
/// Bloom
///---------------------------------------------------------------------------
///***************************************************************************

struct Bloom {
    counter: atomic<u32>,
};

#define use_postprocess_bloom           (use_hq_rendering && 1)
#define use_postprocess_bloom_tailmips  0

#if use_postprocess_bloom

const CH_hdr_output_downsampled = 0;

// https://www.iryoku.com/next-generation-post-processing-in-call-of-duty-advanced-warfare/
fn textureFilterBox4x4(channel: i32, uv: vec2f, dudv: vec2f) -> vec4f {
    let uv_bounds = vec4f(uv - dudv, uv + dudv);

    var box_filter: vec4f;
    box_filter += textureSampleLevel(pass_in, bilinear, uv_bounds.xy, channel, 0);
    box_filter += textureSampleLevel(pass_in, bilinear, uv_bounds.zy, channel, 0);
    box_filter += textureSampleLevel(pass_in, bilinear, uv_bounds.zw, channel, 0);
    box_filter += textureSampleLevel(pass_in, bilinear, uv_bounds.xw, channel, 0);
    return (box_filter / 4.0);
}

// Karis average for first downsample (reduces fireflies)
// This weighted average prevents very bright pixels from dominating
fn karisAverage(color: vec3f) -> f32 {
    let luma = rgbToLuminance(linearTosRgb(color)) * 0.25;
    return 1.0 / (1.0 + luma);
}

// downsample with custom 13 taps for temporal stability (relying on HW texture sampler)
fn mipMapDownSample(channel: i32, uv: vec2f, dudv: vec2f, karis: bool) -> vec4f {
#if 0
    let uv_bounds = vec4f(uv - dudv, uv + dudv);

    // #TODO: check if we have to bother reusing explicitly the 5 redundant taps (with profiling)
    var filtered = vec4f(0.0);
    filtered += textureFilterBox4x4(channel, uv_bounds.xy, dudv) * 0.125;
    filtered += textureFilterBox4x4(channel, uv_bounds.zy, dudv) * 0.125;
    filtered += textureFilterBox4x4(channel, uv_bounds.zw, dudv) * 0.125;
    filtered += textureFilterBox4x4(channel, uv_bounds.xw, dudv) * 0.125;

    filtered += textureFilterBox4x4(channel, uv, dudv) * 0.5;
    return filtered;
#else
    // https://learnopengl.com/Guest-Articles/2022/Phys.-Based-Bloom
    // Take 13 samples around current texel:
    // a - b - c
    // - j - k -
    // d - e - f
    // - l - m -
    // g - h - i
    // === ('e' is the current texel) ===
    let x = dudv.x;
    let y = dudv.y;

    var a = textureSampleLevel(pass_in, bilinear, vec2(uv.x - 2*x, uv.y + 2*y   ), channel, 0).rgb;
    var b = textureSampleLevel(pass_in, bilinear, vec2(uv.x,       uv.y + 2*y   ), channel, 0).rgb;
    var c = textureSampleLevel(pass_in, bilinear, vec2(uv.x + 2*x, uv.y + 2*y   ), channel, 0).rgb;

    var d = textureSampleLevel(pass_in, bilinear, vec2(uv.x - 2*x, uv.y         ), channel, 0).rgb;
    var e = textureSampleLevel(pass_in, bilinear, vec2(uv.x,       uv.y         ), channel, 0).rgb;
    var f = textureSampleLevel(pass_in, bilinear, vec2(uv.x + 2*x, uv.y         ), channel, 0).rgb;

    var g = textureSampleLevel(pass_in, bilinear, vec2(uv.x - 2*x, uv.y - 2*y   ), channel, 0).rgb;
    var h = textureSampleLevel(pass_in, bilinear, vec2(uv.x,       uv.y - 2*y   ), channel, 0).rgb;
    var i = textureSampleLevel(pass_in, bilinear, vec2(uv.x + 2*x, uv.y - 2*y   ), channel, 0).rgb;

    var j = textureSampleLevel(pass_in, bilinear, vec2(uv.x - x,   uv.y + y     ), channel, 0).rgb;
    var k = textureSampleLevel(pass_in, bilinear, vec2(uv.x + x,   uv.y + y     ), channel, 0).rgb;
    var l = textureSampleLevel(pass_in, bilinear, vec2(uv.x - x,   uv.y - y     ), channel, 0).rgb;
    var m = textureSampleLevel(pass_in, bilinear, vec2(uv.x + x,   uv.y - y     ), channel, 0).rgb;

    // Apply weighted distribution:
    // 0.5 + 0.125 + 0.125 + 0.125 + 0.125 = 1
    // a,b,d,e * 0.125
    // b,c,e,f * 0.125
    // d,e,g,h * 0.125
    // e,f,h,i * 0.125
    // j,k,l,m * 0.5
    // This shows 5 square areas that are being sampled. But some of them overlap,
    // so to have an energy preserving downsample we need to make some adjustments.
    // The weights are the distributed, so that the sum of j,k,l,m (e.g.)
    // contribute 0.5 to the final color output. The code below is written
    // to effectively yield this sum. We get:
    // 0.125*5 + 0.03125*4 + 0.0625*4 = 1

    var downsample = vec3f(0.0);

    if (karis) {
        // We are writing to mip 0, so we need to apply Karis average to each block
        // of 4 samples to prevent fireflies (very bright subpixels, leads to pulsating
        // artifacts).
        var groups: array<vec3f, 5>;
        groups[0] = (a+b+d+e) * (0.125f/4.0f);
        groups[1] = (b+c+e+f) * (0.125f/4.0f);
        groups[2] = (d+e+g+h) * (0.125f/4.0f);
        groups[3] = (e+f+h+i) * (0.125f/4.0f);
        groups[4] = (j+k+l+m) * (0.5f/4.0f);
        groups[0] *= karisAverage(groups[0]);
        groups[1] *= karisAverage(groups[1]);
        groups[2] *= karisAverage(groups[2]);
        groups[3] *= karisAverage(groups[3]);
        groups[4] *= karisAverage(groups[4]);
        downsample = groups[0]+groups[1]+groups[2]+groups[3]+groups[4];
    } else {
        downsample = e*0.125;
        downsample += (a+c+g+i)*0.03125;
        downsample += (b+d+f+h)*0.0625;
        downsample += (j+k+l+m)*0.125;
    }

    return vec4f(max(downsample, vec3f(1e-3f)/* completely black pixels will multiply the whole pyramid by 0 */), 1);
#endif
}

// upsampling progressively with 3x3 tent filter (equivalent to bi-quadratic b-spline filtering)
fn mipMapUpSample(channel: i32, uv: vec2f, dudv: vec2f, radius: f32) -> vec4f {
#if 0
    var filtered = vec4f(0.0);
    for (var j = -1; j <= 1; j++) {
    for (var i = -1; i <= 1; i++) {
        let uv_grad = vec2f(vec2(i, j)) * dudv * radius;
        let weight = (2 - abs(vec2(i, j)));

        filtered += textureSampleLevel(pass_in, bilinear, uv + uv_grad, channel, 0) *
                    f32(weight.x*weight.y);
    }}
    return filtered / 16.0;
#else
    // The filter kernel is applied with a radius, specified in texture
    // coordinates, so that the radius will vary across mip resolutions.
    let x = dudv.x;
    let y = dudv.y;

    // Take 9 samples around current texel:
    // a - b - c
    // d - e - f
    // g - h - i
    // === ('e' is the current texel) ===
    let a = textureSampleLevel(pass_in, bilinear, vec2(uv.x - x, uv.y + y)  , channel, 0);
    let b = textureSampleLevel(pass_in, bilinear, vec2(uv.x,     uv.y + y)  , channel, 0);
    let c = textureSampleLevel(pass_in, bilinear, vec2(uv.x + x, uv.y + y)  , channel, 0);

    let d = textureSampleLevel(pass_in, bilinear, vec2(uv.x - x, uv.y)      , channel, 0);
    let e = textureSampleLevel(pass_in, bilinear, vec2(uv.x,     uv.y)      , channel, 0);
    let f = textureSampleLevel(pass_in, bilinear, vec2(uv.x + x, uv.y)      , channel, 0);

    let g = textureSampleLevel(pass_in, bilinear, vec2(uv.x - x, uv.y - y)  , channel, 0);
    let h = textureSampleLevel(pass_in, bilinear, vec2(uv.x,     uv.y - y)  , channel, 0);
    let i = textureSampleLevel(pass_in, bilinear, vec2(uv.x + x, uv.y - y)  , channel, 0);

    // Apply weighted distribution, by using a 3x3 tent filter:
    //  1   | 1 2 1 |
    // -- * | 2 4 2 |
    // 16   | 1 2 1 |
    var upsample = e*4.0;
    upsample += (b+d+f+h)*2.0;
    upsample += (a+c+g+i);
    upsample *= 1.0 / 16.0;
    return upsample;
#endif
}

fn bloomThreshold(color: vec3f) -> vec3f {
    let luma = rgbToLuminance(color);

    // Quadratic curve in threshold region
    let curve = vec2f(custom.bloom_threshold) + vec2f(-1, 1) * custom.bloom_softknee;

    var brightness = max(luma - curve.x, 0.0);
    brightness = min(brightness, curve.y);
    brightness = brightness * brightness * 0.25 / (custom.bloom_softknee + M_EPSILON);

    // Apply threshold
    var contribution = max(brightness, luma - custom.bloom_threshold);
    contribution = contribution / max(luma, M_EPSILON);

    return color * contribution;
}

fn bloomThresholdEnergyConserving(color: vec3f) -> vec3f {
    let luma = rgbToLuminance(color);

    // Calculate how much the luminance exceeds the threshold
    let soft_threshold = custom.bloom_threshold - custom.bloom_softknee;
    var brightness = max(luma - soft_threshold, 0.0);

    // Apply smooth knee
    if (brightness < 2.0 * custom.bloom_softknee) {
        brightness = brightness * brightness / (4.0 * custom.bloom_softknee + M_EPSILON);
    } else {
        brightness = brightness - custom.bloom_softknee;
    }

    // Scale color while preserving hue
    let scale = brightness / max(luma, M_EPSILON);
    return color * scale;
}

fn bloomLoadSourceImage(base: vec2i) -> vec3f {
#if use_temporal_aa
    const channel = CH_TAA_history_buffer;
    let exposure_scale = map.exposure.scale;
#else
    const channel = CH_screenspace_distancefield_cells;
    const exposure_scale = 1.0;
#endif

    let dudv = 1.0 / R.xy;
    let uv = (vec2f(base) + 0.5) * dudv;

    let col = mipMapDownSample(channel, uv, dudv, true).rgb;

    // apply exposure compensation
    let exposed_color = (col / exposure_scale);

    // extract bloom contribution with threshold
    let bloom_color = bloomThresholdEnergyConserving(exposed_color);

    return bloom_color;
}

// Single Pass Downsampler
// https://github.com/GPUOpen-LibrariesAndSDKs/FidelityFX-SDK/blob/f4c1da8e92f3fe563b5c28c44e6267ce6b6b8eb2/Kits/FidelityFX/upscalers/fsr3/include/gpu/spd/ffx_spd.h#L231

// Bloom intermediate filtering:
// Applies 3x3 tent filter in mips_2 to reduce aliasing in the mip chain.
// Note: Subgroup shuffle optimization was attempted but is incompatible with the
// SPD LDS layout (mips_0_1 stores data in SPD-interleaved pattern, not row-major).
// The filtering uses direct LDS loads with edge clamping at workgroup boundaries.
#define use_bloom_filtering 1

enable subgroups;

fn ffxBitfieldExtract(src: u32, off: u32, bits: u32) -> u32 {
    let mask = (1u << bits) - 1;
    return (src >> off) & mask;
}
fn ffxBitfieldInsertMask(src: u32, ins: u32, bits: u32) -> u32 {
    let mask = (1u << bits) - 1;
    return (ins & mask) | (src & (~mask));
}

/// A helper function performing a remap 64x1 to 8x8 remapping which is necessary for 2D wave reductions.
///
/// The 64-wide lane indices to 8x8 remapping is performed as follows:
///
///     00 01 08 09 10 11 18 19
///     02 03 0a 0b 12 13 1a 1b
///     04 05 0c 0d 14 15 1c 1d
///     06 07 0e 0f 16 17 1e 1f
///     20 21 28 29 30 31 38 39
///     22 23 2a 2b 32 33 3a 3b
///     24 25 2c 2d 34 35 3c 3d
///     26 27 2e 2f 36 37 3e 3f
///
/// @param [in] a       The input 1D coordinate to remap.
///
/// @returns
/// The remapped 2D coordinates.
///
/// @ingroup GPUCore
fn ffxRemapForWaveReduction(a: u32) -> vec2u {
    return vec2u(ffxBitfieldInsertMask(ffxBitfieldExtract(a, 2u, 3u), a, 1u),
                 ffxBitfieldInsertMask(ffxBitfieldExtract(a, 3u, 3u), ffxBitfieldExtract(a, 1u, 2u), 2u) );
}

fn bloomIncreaseAtomicCounter() {
    atomicAdd(&game.postprocess.bloom.counter, 1u);
}

fn bloomGetAtomicCounter() -> u32 {
    return atomicLoad(&game.postprocess.bloom.counter);
}

fn bloomResetAtomicCounter() {
    atomicStore(&game.postprocess.bloom.counter, 0u);
}

fn bloomExitWorkgroup(num_workgroups: u32, local_invocation_index: u32) -> bool {
    if (local_invocation_index == 0) {
        bloomIncreaseAtomicCounter();
    }
    workgroupBarrier();
    return (bloomGetAtomicCounter() != (num_workgroups - 1));
}

var<workgroup> s_bloom_intermediate: array<array<RGB9E5, 16>, 16>;

fn bloomLoadIntermediate(x: u32, y: u32) -> vec3f {
    return RGB9E5ToLinear(s_bloom_intermediate[x][y]);
}

fn bloomStoreIntermediate(x: u32, y: u32, value: vec3f) {
    s_bloom_intermediate[x][y] = linearToRGB9E5(value);
}

// =============================================================================
// Bloom Intermediate Filtering
// Applies 3x3 tent filter [1,2,1]x[1,2,1]/16 to reduce aliasing in mip chain
// =============================================================================

// Ground truth: 3x3 tent filter using direct LDS loads with edge clamping
fn bloomLoadIntermediateFiltered(cx: u32, cy: u32, size: u32) -> vec3f {
    let s = i32(size) - 1;
    var sum = vec3f(0.0);
    for (var dy = -1; dy <= 1; dy++) {
        for (var dx = -1; dx <= 1; dx++) {
            let nx = u32(clamp(i32(cx) + dx, 0, s));
            let ny = u32(clamp(i32(cy) + dy, 0, s));
            let weight = f32((2 - abs(dx)) * (2 - abs(dy)));
            sum += bloomLoadIntermediate(nx, ny) * weight;
        }
    }
    return sum / 16.0;
}

fn bloomDownsampledBounds(mip: u32) -> vec4i {
    const margin_for_safe_sampling = 2;
    var bounds = vec4i(0, 0, SCREEN_WIDTH, SCREEN_HEIGHT);
    var offset = vec2i(0, 0);
    for (var i = 0u; i <= mip; i++) {
        let mip_size = bounds.zw >> vec2u(1);
        bounds = vec4(offset, mip_size);
        offset += select(mip_size, vec2i(mip_size.x, 0), i == 0u) + margin_for_safe_sampling;
    }
    return bounds;
}

fn bloomStoreDownsampled(pix: vec2i, value: vec3f, mip: u32) {
    let mip_bounds = bloomDownsampledBounds(mip);
    if (any((pix < vec2i(0)) | (pix >= mip_bounds.zw))) {
        return;
    }

    // #TODO: remove this error detector
    var store = select(value, errorPalette(), isNaN3(value));
    passStore(CH_hdr_output_downsampled, mip_bounds.xy + pix, vec4f(store, 0));
}

fn bloomLoadDownsampled(pix: vec2i, mip: u32) -> vec3f {
    let mip_bounds = bloomDownsampledBounds(mip);
    if (any((pix < vec2i(0)) | (pix >= mip_bounds.zw))) {
        return vec3f(0);
    }

    return passLoad(CH_hdr_output_downsampled, mip_bounds.xy + pix, 0).rgb;
}

fn bloomLoadDownsampledCorner(pix: vec2i, mip: u32) -> vec3f {
    let c00 = bloomLoadDownsampled(pix + vec2i(-1, -1), mip);
    let c10 = bloomLoadDownsampled(pix + vec2i( 0, -1), mip);
    let c01 = bloomLoadDownsampled(pix + vec2i(-1,  0), mip);
    let c11 = bloomLoadDownsampled(pix + vec2i( 0,  0), mip);
    return (c00 + c10 + c01 + c11) * 0.25;
}

fn mipMapDownSampleSafe(center_pix: vec2i, src_mip: u32, karis: bool) -> vec3f {
    let a = bloomLoadDownsampledCorner(center_pix + vec2i(-2, -2), src_mip);
    let b = bloomLoadDownsampledCorner(center_pix + vec2i( 0, -2), src_mip);
    let c = bloomLoadDownsampledCorner(center_pix + vec2i( 2, -2), src_mip);

    let d = bloomLoadDownsampledCorner(center_pix + vec2i(-2,  0), src_mip);
    let e = bloomLoadDownsampledCorner(center_pix + vec2i( 0,  0), src_mip);
    let f = bloomLoadDownsampledCorner(center_pix + vec2i( 2,  0), src_mip);

    let g = bloomLoadDownsampledCorner(center_pix + vec2i(-2,  2), src_mip);
    let h = bloomLoadDownsampledCorner(center_pix + vec2i( 0,  2), src_mip);
    let i = bloomLoadDownsampledCorner(center_pix + vec2i( 2,  2), src_mip);

    let j = bloomLoadDownsampledCorner(center_pix + vec2i(-1, -1), src_mip);
    let k = bloomLoadDownsampledCorner(center_pix + vec2i( 1, -1), src_mip);
    let l = bloomLoadDownsampledCorner(center_pix + vec2i(-1,  1), src_mip);
    let m = bloomLoadDownsampledCorner(center_pix + vec2i( 1,  1), src_mip);

    var downsample = vec3f(0.0);

    if (karis) {
        var groups: array<vec3f, 5>;
        groups[0] = (a+b+d+e) * (0.125f/4.0f);
        groups[1] = (b+c+e+f) * (0.125f/4.0f);
        groups[2] = (d+e+g+h) * (0.125f/4.0f);
        groups[3] = (e+f+h+i) * (0.125f/4.0f);
        groups[4] = (j+k+l+m) * (0.5f/4.0f);
        groups[0] *= karisAverage(groups[0]);
        groups[1] *= karisAverage(groups[1]);
        groups[2] *= karisAverage(groups[2]);
        groups[3] *= karisAverage(groups[3]);
        groups[4] *= karisAverage(groups[4]);
        downsample = groups[0]+groups[1]+groups[2]+groups[3]+groups[4];
    } else {
        downsample = e*0.125;
        downsample += (a+c+g+i)*0.03125;
        downsample += (b+d+f+h)*0.0625;
        downsample += (j+k+l+m)*0.125;
    }

    return downsample;
}

fn bloomReduce4(v0: vec3f, v1: vec3f, v2: vec3f, v3: vec3f) -> vec3f {
    // simple box blur
    return (v0 + v1 + v2 + v3) * 0.25;
}

fn bloomReduceQuad(v: vec3f) -> vec3f {
    let v0 = v;
    let v1 = quadSwapX(v);
    let v2 = quadSwapY(v);
    let v3 = quadSwapDiagonal(v);
    return bloomReduce4(v0, v1, v2, v3);
}

fn bloomReduceIntermediate4(i0: vec2u, i1: vec2u, i2: vec2u, i3: vec2u) -> vec3f {
    let v0 = bloomLoadIntermediate(i0.x, i0.y);
    let v1 = bloomLoadIntermediate(i1.x, i1.y);
    let v2 = bloomLoadIntermediate(i2.x, i2.y);
    let v3 = bloomLoadIntermediate(i3.x, i3.y);
    return bloomReduce4(v0, v1, v2, v3);
}

fn bloomReduceLoad4(i0: vec2i, i1: vec2i, i2: vec2i, i3: vec2i, mip: u32) -> vec3f {
    let v0 = bloomLoadDownsampled(i0, mip);
    let v1 = bloomLoadDownsampled(i1, mip);
    let v2 = bloomLoadDownsampled(i2, mip);
    let v3 = bloomLoadDownsampled(i3, mip);
    return bloomReduce4(v0, v1, v2, v3);
}

fn bloomReduceLoadBase4(base: vec2i, mip: u32) -> vec3f {
    return bloomReduceLoad4(base, base + vec2i(0, 1), base + vec2i(1, 0), base + vec2i(1, 1), mip);
}

fn bloomDownsampleMips_0_1( x: u32, y: u32,
                            workgroup_id: vec2u,
                            local_idx: u32,
                            mips: u32 ) {
    var v: array<vec3f, 4>;
    var tex: vec2i;
    var pix: vec2i;

    tex = vec2i(workgroup_id.xy * 64) + vec2i(vec2(x * 2, y * 2));
    pix = vec2i(workgroup_id.xy * 32) + vec2i(vec2(x, y));
    v[0] = bloomLoadSourceImage(tex);
    bloomStoreDownsampled(pix, v[0], 0);

    tex = vec2i(workgroup_id.xy * 64) + vec2i(vec2(x * 2 + 32, y * 2));
    pix = vec2i(workgroup_id.xy * 32) + vec2i(vec2(x + 16, y));
    v[1] = bloomLoadSourceImage(tex);
    bloomStoreDownsampled(pix, v[1], 0);

    tex = vec2i(workgroup_id.xy * 64) + vec2i(vec2(x * 2, y * 2 + 32));
    pix = vec2i(workgroup_id.xy * 32) + vec2i(vec2(x, y + 16));
    v[2] = bloomLoadSourceImage(tex);
    bloomStoreDownsampled(pix, v[2], 0);

    tex = vec2i(workgroup_id.xy * 64) + vec2i(vec2(x * 2, y * 2) + 32);
    pix = vec2i(workgroup_id.xy * 32) + vec2i(vec2(x, y) + 16);
    v[3] = bloomLoadSourceImage(tex);
    bloomStoreDownsampled(pix, v[3], 0);

    if (mips <= 1) {
        return;
    }

    v[0] = bloomReduceQuad(v[0]);
    v[1] = bloomReduceQuad(v[1]);
    v[2] = bloomReduceQuad(v[2]);
    v[3] = bloomReduceQuad(v[3]);

    if ((local_idx % 4) == 0) {
        bloomStoreDownsampled(vec2i(workgroup_id.xy * 16) + vec2i(vec2(x / 2, y / 2)), v[0], 1);
        bloomStoreIntermediate(x / 2, y / 2, v[0]);

        bloomStoreDownsampled(vec2i(workgroup_id.xy * 16) + vec2i(vec2(x / 2 + 8, y / 2)), v[1], 1);
        bloomStoreIntermediate(x / 2 + 8, y / 2, v[1]);

        bloomStoreDownsampled(vec2i(workgroup_id.xy * 16) + vec2i(vec2(x / 2, y / 2 + 8)), v[2], 1);
        bloomStoreIntermediate(x / 2, y / 2 + 8, v[2]);

        bloomStoreDownsampled(vec2i(workgroup_id.xy * 16) + vec2i(vec2(x / 2 + 8, y / 2 + 8)), v[3], 1);
        bloomStoreIntermediate(x / 2 + 8, y / 2 + 8, v[3]);
    }
}

fn bloomDownsampleMips_2(   x: u32, y: u32,
                            workgroup_id: vec2u,
                            local_idx: u32,
                            base_mip: u32 ) {
    // Apply 3x3 tent filter (16x16 spatially coherent data from mips_0_1)
    var v = bloomLoadIntermediateFiltered(x, y, 16u);
    v = bloomReduceQuad(v);
    // quad index 0 stores result
    if ((local_idx % 4u) == 0u) {
        let out_x = x / 2u;
        let out_y = y / 2u;
        bloomStoreDownsampled(vec2i(workgroup_id.xy * 8u) + vec2i(vec2(out_x, out_y)), v, base_mip);
        // Store in SIMPLE row-major pattern (8x8) for next stage's filtering
        bloomStoreIntermediate(out_x, out_y, v);
    }
}

fn bloomDownsampleMips_3(   x: u32, y: u32,
                            workgroup_id: vec2u,
                            local_idx: u32,
                            base_mip: u32 ) {
    // LDS now has 8x8 row-major data from mips_2, apply filtering
    // Thread (x, y) in 0-7 range processes position (x, y) from the 8x8 grid
    var v = bloomLoadIntermediateFiltered(x, y, 8u);
    v = bloomReduceQuad(v);
    // quad index 0 stores result
    if (local_idx < 64u && (local_idx % 4u) == 0u) {
        let out_x = x / 2u;
        let out_y = y / 2u;
        bloomStoreDownsampled(vec2i(workgroup_id.xy * 4u) + vec2i(vec2(out_x, out_y)), v, base_mip);
        // Store in simple row-major pattern (4x4) for next stage
        bloomStoreIntermediate(out_x, out_y, v);
    }
}

fn bloomDownsampleMips_4(   x: u32, y: u32,
                            workgroup_id: vec2u,
                            local_idx: u32,
                            base_mip: u32 ) {
    // LDS now has 4x4 row-major data from mips_3, apply filtering
    var v = bloomLoadIntermediateFiltered(x, y, 4u);
    v = bloomReduceQuad(v);
    // quad index 0 stores result
    if (local_idx < 16u && (local_idx % 4u) == 0u) {
        let out_x = x / 2u;
        let out_y = y / 2u;
        bloomStoreDownsampled(vec2i(workgroup_id.xy * 2u) + vec2i(vec2(out_x, out_y)), v, base_mip);
        // Store in simple row-major pattern (2x2) for next stage
        bloomStoreIntermediate(out_x, out_y, v);
    }
}

fn bloomDownsampleMips_5(   x: u32, y: u32,
                            workgroup_id: vec2u,
                            local_idx: u32,
                            base_mip: u32 ) {
    // LDS has 2x2 row-major data from mips_4
    // Threads 0-3 form a quad at positions (0,0), (1,0), (0,1), (1,1)
    // At 2x2, filtering is not beneficial, just reduce
    var v = vec3f(0.0);
    if (local_idx < 4u) {
        v = bloomLoadIntermediate(x, y);
    }
    v = bloomReduceQuad(v);
    // Thread 0 (quad leader) stores the final 1x1 result
    if (local_idx == 0u) {
        bloomStoreDownsampled(vec2i(workgroup_id.xy), v, base_mip);
    }
}

fn bloomDownsampleMips_6_7( x: u32, y: u32,
                            base_mip: u32 ) {
    if (base_mip <= 6) { return; }
    var tex = vec2i(vec2(x * 4 + 0, y * 4 + 0));
    var pix = vec2i(vec2(x * 2 + 0, y * 2 + 0));
    let v0  = bloomReduceLoadBase4(tex, 5);
    bloomStoreDownsampled(pix, v0, 6);

    tex     = vec2i(vec2(x * 4 + 2, y * 4 + 0));
    pix     = vec2i(vec2(x * 2 + 1, y * 2 + 0));
    let v1  = bloomReduceLoadBase4(tex, 5);
    bloomStoreDownsampled(pix, v1, 6);

    tex     = vec2i(vec2(x * 4 + 0, y * 4 + 2));
    pix     = vec2i(vec2(x * 2 + 0, y * 2 + 1));
    let v2  = bloomReduceLoadBase4(tex, 5);
    bloomStoreDownsampled(pix, v2, 6);

    tex     = vec2i(vec2(x * 4 + 2, y * 4 + 2));
    pix     = vec2i(vec2(x * 2 + 1, y * 2 + 1));
    let v3  = bloomReduceLoadBase4(tex, 5);
    bloomStoreDownsampled(pix, v3, 6);

    if (base_mip <= 7) { return; }
    // no barrier needed, working on values only from the same thread

    let v = bloomReduce4(v0, v1, v2, v3);
    bloomStoreDownsampled(vec2i(vec2(x, y)), v, 7);
    bloomStoreIntermediate(x, y, v);
}

fn bloomDownsampleNextFour( x: u32, y: u32,
                            workgroup_id: vec2u,
                            local_idx: u32,
                            base_mip: u32,
                            mips: u32 ) {
    workgroupBarrier();
    bloomDownsampleMips_2(x, y, workgroup_id, local_idx, base_mip);

    workgroupBarrier();
    bloomDownsampleMips_3(x, y, workgroup_id, local_idx, base_mip + 1);

    workgroupBarrier();
    bloomDownsampleMips_4(x, y, workgroup_id, local_idx, base_mip + 2);

    workgroupBarrier();
    bloomDownsampleMips_5(x, y, workgroup_id, local_idx, base_mip + 3);
}

fn bloomDownsampleTail(local_idx: u32, base_mip: u32, target_mip: u32) {
    // if (base_mip <= 6) { return; }

    // We start from Mip 6 (which is generated from Mip 5)
    // and go as deep as requested (e.g., to Mip 10)

    var src_mip = 5u; // We start reading from Mip 5

    // Loop through each subsequent mip level
    for (var m = 6u; m <= bloom_mips - 1; m++) {

        if (base_mip <= m) {
            // 1. Calculate dimensions for the specific mip we are WRITING to (m)
            let bounds = bloomDownsampledBounds(m);
            let size   = vec2i(bounds.zw);
            let total_pixels = u32(size.x * size.y);

            // 2. Grid-Stride Loop: All 256 threads help process this mip level
            for (var i = local_idx; i < total_pixels; i += 256u) {
                let x = i32(i) % size.x;
                let y = i32(i) / size.x;
                let pix = vec2i(x, y);

                // Calculate source coordinates in the previous mip (src_mip)
                // Center of the 2x2 block in src_mip corresponding to pix in current mip
                let center_pix = pix * 2 + 1;

                // Downsample and Store
                let v = mipMapDownSampleSafe(center_pix, src_mip, false);

                if (all(pix < size)) {
                    bloomStoreDownsampled(pix, v, m);

                    // Optimization: If we are at the very bottom of the chain (tiny mips),
                    // store the 1x1 result to LDS or intermediate for debugging/upsampling if needed.
                    if (m == target_mip && i == 0u) {
                        bloomStoreIntermediate(0, 0, v);
                    }
                }
            }
        }

        // 3. BARRIER: Wait for Mip 'm' to be fully written before starting 'm+1'
        // This is crucial. Without this, the next iteration reads unwritten data.
        workgroupBarrier();

        // Prepare for next iteration
        src_mip = m;
    }
}

// Each workgroup processes 64x64 input pixels
#calcdefine BLOOM_DOWNSAMPLE_WORKGROUP_COUNT_X ((SCREEN_WIDTH  + 63) / 64)
#calcdefine BLOOM_DOWNSAMPLE_WORKGROUP_COUNT_Y ((SCREEN_HEIGHT + 63) / 64)

#if use_postprocess_bloom_tailmips
const bloom_mips = 11;
#else
const bloom_mips = 6;
#endif

#workgroup_count pass_postprocess_bloom_downsample BLOOM_DOWNSAMPLE_WORKGROUP_COUNT_X BLOOM_DOWNSAMPLE_WORKGROUP_COUNT_Y 1
@compute @workgroup_size(256, 1, 1)
fn pass_postprocess_bloom_downsample(   @builtin(workgroup_id) wid: vec3u,
                                        @builtin(local_invocation_index) local_idx: u32 ) {
    // compute MIP level 0 and 1
    let sub_xy = ffxRemapForWaveReduction(local_idx % 64);
    let x = sub_xy.x + 8 * ((local_idx >> 6) % 2);
    let y = sub_xy.y + 8 * ((local_idx >> 7));
    bloomDownsampleMips_0_1(x, y, wid.xy, local_idx, bloom_mips);

    // compute MIP level 2, 3, 4, 5
    bloomDownsampleNextFour(x, y, wid.xy, local_idx, 2, bloom_mips);

    if (bloom_mips > 6) {
        const num_workgroups = BLOOM_DOWNSAMPLE_WORKGROUP_COUNT_X * BLOOM_DOWNSAMPLE_WORKGROUP_COUNT_Y;

        let last_workgroup = !bloomExitWorkgroup(num_workgroups, local_idx);

        bloomDownsampleTail(local_idx, select(0u, bloom_mips, last_workgroup), bloom_mips - 1);
    }
}

//=============================================================================
// Multi-pass bloom upsampling
// Each pass reads from the previous mip (using hardware bilinear filtering)
// and writes to the current mip. This avoids LDS boundary issues.
//=============================================================================

const bloom_upsampling_radius = 1.0;

// Get bounds for upsampled mip storage (Y-flipped from downsampled mips)
fn bloomUpsampledMipBounds(mip: u32) -> vec4i {
    var mip_bounds = bloomDownsampledBounds(mip);
    let mip_offset = vec2(SCREEN_WIDTH - mip_bounds.x - mip_bounds.z, SCREEN_HEIGHT - mip_bounds.w);
    return vec4(mip_offset, mip_bounds.zw);
}

// Sample from downsampled mip in atlas with tent filter
fn bloomBlurDownsampledMip(uv: vec2f, mip: u32) -> vec3f {
    let mip_bounds = vec4f(bloomDownsampledBounds(mip));
    const atlas_dudv = 1.0 / vec2f(SCREEN_WIDTH, SCREEN_HEIGHT);
    let atlas_uv = (mip_bounds.xy + uv * mip_bounds.zw) * atlas_dudv;
    return mipMapUpSample(CH_hdr_output_downsampled, atlas_uv, atlas_dudv, bloom_upsampling_radius).rgb;
}

// Sample from upsampled mip in atlas with bilinear filter
fn bloomSampleUpsampledMip(uv: vec2f, mip: u32) -> vec3f {
    let mip_bounds = vec4f(bloomUpsampledMipBounds(mip));
    const atlas_dudv = 1.0 / vec2f(SCREEN_WIDTH, SCREEN_HEIGHT);
    let atlas_uv = (mip_bounds.xy + uv * mip_bounds.zw) * atlas_dudv;
    return mipMapUpSample(CH_hdr_output_downsampled, atlas_uv, atlas_dudv, bloom_upsampling_radius).rgb;
}

// Store upsampled mip to atlas (Y-flipped region)
fn bloomStoreUpsampled(pix: vec2i, value: vec3f, mip: u32) {
    let mip_bounds = bloomUpsampledMipBounds(mip);
    if (any((pix < vec2i(0)) | (pix >= mip_bounds.zw))) {
        return;
    }

// #TODO: remove this error detector once NAN output is fixed
    var store = select(value, errorPalette(), isNaN3(value));
    passStore(CH_hdr_output_downsampled, mip_bounds.xy + pix, vec4f(store, 0));
}

// Mip sizes for dispatch counts
#calcdefine BLOOM_MIP5_WIDTH    (SCREEN_WIDTH   / 64)
#calcdefine BLOOM_MIP5_HEIGHT   (SCREEN_HEIGHT  / 64)
#calcdefine BLOOM_MIP4_WIDTH    (SCREEN_WIDTH   / 32)
#calcdefine BLOOM_MIP4_HEIGHT   (SCREEN_HEIGHT  / 32)
#calcdefine BLOOM_MIP3_WIDTH    (SCREEN_WIDTH   / 16)
#calcdefine BLOOM_MIP3_HEIGHT   (SCREEN_HEIGHT  / 16)
#calcdefine BLOOM_MIP2_WIDTH    (SCREEN_WIDTH   /  8)
#calcdefine BLOOM_MIP2_HEIGHT   (SCREEN_HEIGHT  /  8)
#calcdefine BLOOM_MIP1_WIDTH    (SCREEN_WIDTH   /  4)
#calcdefine BLOOM_MIP1_HEIGHT   (SCREEN_HEIGHT  /  4)
#calcdefine BLOOM_MIP0_WIDTH    (SCREEN_WIDTH   /  2)
#calcdefine BLOOM_MIP0_HEIGHT   (SCREEN_HEIGHT  /  2)

#define BLOOM_UPSAMPLING_WORKGROUP_SIZE 16

// Pass 1: Upsample mip 5
#calcdefine BLOOM_UP_5_WG_X ((BLOOM_MIP5_WIDTH  + BLOOM_UPSAMPLING_WORKGROUP_SIZE - 1) / BLOOM_UPSAMPLING_WORKGROUP_SIZE)
#calcdefine BLOOM_UP_5_WG_Y ((BLOOM_MIP5_HEIGHT + BLOOM_UPSAMPLING_WORKGROUP_SIZE - 1) / BLOOM_UPSAMPLING_WORKGROUP_SIZE)

#workgroup_count pass_bloom_upsample_5 BLOOM_UP_5_WG_X BLOOM_UP_5_WG_Y 1
@compute @workgroup_size(BLOOM_UPSAMPLING_WORKGROUP_SIZE, BLOOM_UPSAMPLING_WORKGROUP_SIZE, 1)
fn pass_bloom_upsample_5(@builtin(global_invocation_id) gid: vec3u) {
    let pix = vec2i(gid.xy);

    const mip_size = vec2i(BLOOM_MIP5_WIDTH, BLOOM_MIP5_HEIGHT);
    if (any(pix >= mip_size)) { return; }

    //let uv = (vec2f(pix) + 0.5) / vec2f(mip_size);
    let uv = (vec2f(pix) + 0.5) / vec2f(bloomUpsampledMipBounds(5).zw);
    var value = bloomBlurDownsampledMip(uv, 5u);

    bloomStoreUpsampled(pix, value, 5u);
}

// Pass 2: Upsample mip 4
#calcdefine BLOOM_UP_4_WG_X ((BLOOM_MIP4_WIDTH  + BLOOM_UPSAMPLING_WORKGROUP_SIZE - 1) / BLOOM_UPSAMPLING_WORKGROUP_SIZE)
#calcdefine BLOOM_UP_4_WG_Y ((BLOOM_MIP4_HEIGHT + BLOOM_UPSAMPLING_WORKGROUP_SIZE - 1) / BLOOM_UPSAMPLING_WORKGROUP_SIZE)

#workgroup_count pass_bloom_upsample_4 BLOOM_UP_4_WG_X BLOOM_UP_4_WG_Y 1
@compute @workgroup_size(BLOOM_UPSAMPLING_WORKGROUP_SIZE, BLOOM_UPSAMPLING_WORKGROUP_SIZE, 1)
fn pass_bloom_upsample_4(@builtin(global_invocation_id) gid: vec3u) {
    let pix = vec2i(gid.xy);

    const mip_size = vec2i(BLOOM_MIP4_WIDTH, BLOOM_MIP4_HEIGHT);
    if (any(pix >= mip_size)) { return; }

    //let uv = (vec2f(pix) + 0.5) / vec2f(mip_size);
    let uv = (vec2f(pix) + 0.5) / vec2f(bloomUpsampledMipBounds(4).zw);
    var value = bloomBlurDownsampledMip(uv, 4u);
    value += bloomSampleUpsampledMip(uv, 5u);

    bloomStoreUpsampled(pix, value, 4u);
}

// Pass 3: Upsample mip 3
#calcdefine BLOOM_UP_3_WG_X ((BLOOM_MIP3_WIDTH  + BLOOM_UPSAMPLING_WORKGROUP_SIZE - 1) / BLOOM_UPSAMPLING_WORKGROUP_SIZE)
#calcdefine BLOOM_UP_3_WG_Y ((BLOOM_MIP3_HEIGHT + BLOOM_UPSAMPLING_WORKGROUP_SIZE - 1) / BLOOM_UPSAMPLING_WORKGROUP_SIZE)

#workgroup_count pass_bloom_upsample_3 BLOOM_UP_3_WG_X BLOOM_UP_3_WG_Y 1
@compute @workgroup_size(BLOOM_UPSAMPLING_WORKGROUP_SIZE, BLOOM_UPSAMPLING_WORKGROUP_SIZE, 1)
fn pass_bloom_upsample_3(@builtin(global_invocation_id) gid: vec3u) {
    let pix = vec2i(gid.xy);

    const mip_size = vec2i(BLOOM_MIP3_WIDTH, BLOOM_MIP3_HEIGHT);
    if (any(pix >= mip_size)) { return; }

    //let uv = (vec2f(pix) + 0.5) / vec2f(mip_size);
    let uv = (vec2f(pix) + 0.5) / vec2f(bloomUpsampledMipBounds(3).zw);
    var value = bloomBlurDownsampledMip(uv, 3u);
    value += bloomSampleUpsampledMip(uv, 4u);

    bloomStoreUpsampled(pix, value, 3u);
}

// Pass 4: Upsample mip 2
#calcdefine BLOOM_UP_2_WG_X ((BLOOM_MIP2_WIDTH  + BLOOM_UPSAMPLING_WORKGROUP_SIZE - 1) / BLOOM_UPSAMPLING_WORKGROUP_SIZE)
#calcdefine BLOOM_UP_2_WG_Y ((BLOOM_MIP2_HEIGHT + BLOOM_UPSAMPLING_WORKGROUP_SIZE - 1) / BLOOM_UPSAMPLING_WORKGROUP_SIZE)

#workgroup_count pass_bloom_upsample_2 BLOOM_UP_2_WG_X BLOOM_UP_2_WG_Y 1
@compute @workgroup_size(BLOOM_UPSAMPLING_WORKGROUP_SIZE, BLOOM_UPSAMPLING_WORKGROUP_SIZE, 1)
fn pass_bloom_upsample_2(@builtin(global_invocation_id) gid: vec3u) {
    let pix = vec2i(gid.xy);

    const mip_size = vec2i(BLOOM_MIP2_WIDTH, BLOOM_MIP2_HEIGHT);
    if (any(pix >= mip_size)) { return; }

    // let uv = (vec2f(pix) + 0.5) / vec2f(mip_size);
    let uv = (vec2f(pix) + 0.5) / vec2f(bloomUpsampledMipBounds(2).zw);
    var value = bloomBlurDownsampledMip(uv, 2u);
    value += bloomSampleUpsampledMip(uv, 3u);

    bloomStoreUpsampled(pix, value, 2u);
}

// Pass 5: Upsample mip 1
#calcdefine BLOOM_UP_1_WG_X ((BLOOM_MIP1_WIDTH  + BLOOM_UPSAMPLING_WORKGROUP_SIZE - 1) / BLOOM_UPSAMPLING_WORKGROUP_SIZE)
#calcdefine BLOOM_UP_1_WG_Y ((BLOOM_MIP1_HEIGHT + BLOOM_UPSAMPLING_WORKGROUP_SIZE - 1) / BLOOM_UPSAMPLING_WORKGROUP_SIZE)

#workgroup_count pass_bloom_upsample_1 BLOOM_UP_1_WG_X BLOOM_UP_1_WG_Y 1
@compute @workgroup_size(BLOOM_UPSAMPLING_WORKGROUP_SIZE, BLOOM_UPSAMPLING_WORKGROUP_SIZE, 1)
fn pass_bloom_upsample_1(@builtin(global_invocation_id) gid: vec3u) {
    let pix = vec2i(gid.xy);

    const mip_size = vec2i(BLOOM_MIP1_WIDTH, BLOOM_MIP1_HEIGHT);
    if (any(pix >= mip_size)) { return; }

    // let uv = (vec2f(pix) + 0.5) / vec2f(mip_size);
    let uv = (vec2f(pix) + 0.5) / vec2f(bloomUpsampledMipBounds(1).zw);
    var value = bloomBlurDownsampledMip(uv, 1u);
    value += bloomSampleUpsampledMip(uv, 2u);

    bloomStoreUpsampled(pix, value, 1u);
}


// Pass 6: Upsample mip 0
#calcdefine BLOOM_UP_0_WG_X ((BLOOM_MIP0_WIDTH  + BLOOM_UPSAMPLING_WORKGROUP_SIZE - 1) / BLOOM_UPSAMPLING_WORKGROUP_SIZE)
#calcdefine BLOOM_UP_0_WG_Y ((BLOOM_MIP0_HEIGHT + BLOOM_UPSAMPLING_WORKGROUP_SIZE - 1) / BLOOM_UPSAMPLING_WORKGROUP_SIZE)

#workgroup_count pass_bloom_upsample_0 BLOOM_UP_0_WG_X BLOOM_UP_0_WG_Y 1
@compute @workgroup_size(BLOOM_UPSAMPLING_WORKGROUP_SIZE, BLOOM_UPSAMPLING_WORKGROUP_SIZE, 1)
fn pass_bloom_upsample_0(@builtin(global_invocation_id) gid: vec3u) {
    let pix = vec2i(gid.xy);

    const mip_size = vec2i(BLOOM_MIP0_WIDTH, BLOOM_MIP0_HEIGHT);
    if (any(pix >= mip_size)) { return; }

    // let uv = (vec2f(pix) + 0.5) / vec2f(mip_size);
    let uv = (vec2f(pix) + 0.5) / vec2f(bloomUpsampledMipBounds(0).zw);
    var value = bloomBlurDownsampledMip(uv, 0u);
    value += bloomSampleUpsampledMip(uv, 1u);

    bloomStoreUpsampled(pix, value, 0u);
}

fn bloomSample(uv: vec2f) -> vec3f {
#if use_temporal_aa
    let exposure_scale = map.exposure.scale;
#else
    const exposure_scale = 1.0;
#endif
    return bloomSampleUpsampledMip(uv, 0) * exposure_scale;
}

#endif //!use_postprocess_bloom

///***************************************************************************
///---------------------------------------------------------------------------
/// Barrel chroma blur
///---------------------------------------------------------------------------
///***************************************************************************

// https://www.shadertoy.com/view/XssGz8

#define use_postprocess_barrelchroma 1

// Simple spectral weighting: shifts color along RGB spectrum
fn spectrum_offset_rgb(t: f32) -> vec3f {
    // Compress and shift t into a symmetric shape
    let t0 = 3.0 * t - 1.5;
    // Three lobes forming R G B emphasis zones
    return clamp(vec3f(-t0, 1.0 - abs(t0), t0), vec3f(0.0), vec3f(1.0));
}

// Brown–Conrady lens distortion (barrel if dist > 0)
fn brownConradyDistortion(uv: vec2f, dist: f32) -> vec2f {
    var p = uv * 2.0 - 1.0;
    let k1 = 0.1 * dist;
    let k2 = -0.025 * dist;
    let r2 = dot(p, p);
    p *= 1.0 + k1 * r2 + k2 * r2 * r2;
    return p * 0.5 + 0.5;
}

// Core chroma-distortion blur
fn applyBarrelChroma(channel: i32, frag_coord: vec2f, distortion: f32) -> vec3f {
    const num_iter = 7;
    const stepsiz = 1.0 / f32(num_iter - 1);

    let rnd = interleavedGradientNoise(vec2i(floor(frag_coord)), 0);
    let uv = frag_coord / R;

    var t = rnd * stepsiz;
    var sum_col = vec3f(0.0);
    var sum_w = vec3f(0.0);

    for (var i = 0; i < num_iter; i++) {
        let w = spectrum_offset_rgb(t);
        sum_w += w;

        let uvd = brownConradyDistortion(uv, distortion * t);
        sum_col += w * textureSampleLevel(pass_in, bilinear, uvd, channel, 0).rgb;

        t += stepsiz;
    }

    return sum_col / sum_w;
}

fn applyNaturalVignette(frag_coord: vec2f, col: vec3f, falloff: f32) -> vec3f {
    let uv = frag_coord.xy / R.xy;
    let coord = (uv - 0.5) * (R.x/R.y) * 2.0;
    let rf = 1.0 + dot(coord, coord) * falloff * falloff;
    return col  / (rf * rf);
}

///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//////
//////
////// Final compositing to screen (sRGB) with tonemapper & UI
//////
//////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////

@compute @workgroup_size(16, 16)
fn main_image(  @builtin(global_invocation_id) id: vec3u,
                @builtin(workgroup_id) wid: vec3u) {

    var frag_coord = fragmentCoord(vec2i(id.xy));

    var p = reconstructOpaquePosition(frag_coord);
    let ddx_p = reconstructOpaquePosition(frag_coord + vec2f(1,0));
    let ddy_p = reconstructOpaquePosition(frag_coord + vec2f(0,1));

    var p_ddx = p - ddx_p;
    var p_ddy = p - ddy_p;

    //toolBrushApplyZoom(&frag_coord, &p, &p_ddx, &p_ddy);

    let local_pos = p - world_bounds_min;
    canvasInit(local_pos.xy, p_ddx.xy, p_ddy.xy);

#if use_postprocess_barrelchroma
#if use_temporal_aa
    var col = applyBarrelChroma(CH_TAA_history_buffer, frag_coord, custom.barrel_distorsion);
#else
    var col = applyBarrelChroma(CH_screenspace_distancefield_cells, frag_coord, custom.barrel_distorsion);
#endif
#else
#if use_temporal_aa
    var col = passLoad(CH_TAA_history_buffer, vec2i(frag_coord.xy), 0).rgb;
#else
    var col = passLoad(CH_screenspace_distancefield_cells, vec2i(frag_coord.xy), 0).rgb;
#endif
#endif

#if use_temporal_aa && 0 // debug TAA
    if (frag_coord.x > R_halfRes.x) {
        let unjitter_uv = (frag_coord - taaFragmentOffset(time.frame)) / R.xy;
        col = passSampleLevelBilinearRepeat(CH_screenspace_distancefield_cells, unjitter_uv, 0).rgb * map.exposure.scale;
    }
#endif

#if use_postprocess_bloom
    #if 0 // debug bloom
    if (frag_coord.x > R_halfRes.x) {
        col = bloomSample((frag_coord + 0.5) / R);
    } else
    #endif
    {
        col = col + bloomSample((frag_coord + 0.5) / R) * custom.bloom_intensity;
    }
#endif

    // --- Apply tonemapping: all colors linear from now on ---
    col = tonemapAGX(col, agx_look_punchy);

    // --- Post-Processing ---
    col = applyNaturalVignette(frag_coord, col, custom.vignette);

#if 1
    // --- Draw map borders ---
    {
        let restore_style = canvas.style;

        canvas.style.fill = vec4(0);
        canvas.style.stroke = vec4f(1);
        canvas.style.stroke_width = 3;
        canvas.style.stroke_offset = 0;
        canvas.style.glow = vec4(0.3);
        canvas.style.glow_width = 10.0;
        canvas.style.feather = 1;

        canvasDrawBox(vec2f(map_dim_2d)/2, vec2f(map_dim_2d)/2 + 0.5 + 1.5 * game.cam.zoom);

        canvas.style = restore_style;
    }

    // --- Tool brush feedback ---
    if (game.tool_allowed != tool_none) {
        let brush_grad = toolBrushGrad(local_pos.xy);
        let brush_col = toolBrushColor(game.tool_allowed);

        let mgrad = local_pos.xy - game.mouse_world_pos.xy;

        //let fade = exp(-0.2*(abs(length_sq2f(mgrad) - sqr(game.brush_radius)))/sqr(game.brush_radius));
        var fade = 1.0 * gaussianGrad2d(mgrad, game.brush_radius);
        if (game.tool_allowed == tool_light) {
            fade = vec3f(1.0);
        }

        let dash_len = 8.0;
        var dash_alpha = abs(fract(dash_len * (atan2(mgrad.y, mgrad.x) / M_PI + time.elapsed * 0.5)) - 0.5);
        dash_alpha = smoothstep(0.35, 0.25, dash_alpha);

        let restore_style = canvas.style;
        canvas.style.stroke = vec4(brush_col, clamp(dash_alpha, 0, 1));
        canvas.style.stroke_width = 3;
        canvas.style.stroke_offset = 1;
        canvas.style.fill = vec4f(brush_col, cub(1-fade.z));
        canvas.style.feather = 4.0;
        canvasDrawSDF(brush_grad.z, canvas.ddxyLen);
        canvas.style = restore_style;
    }
#endif

    // --- Mouse debugging, aka 'gpu printf debugging" ---


    // --- User-Interface ---
    // #TODO: move to separate pass?
#if 1
    // Render UI only if inside its bounds (+margin for outer glow)
    uiInitDefaults(frag_coord);
    if (all((frag_coord >= game.ui_bounds.xy - 8) & (frag_coord <= game.ui_bounds.zw * 2 + 8))) {
        uiRender(frag_coord, false);
    }

    ui.style.font = typeface_small;
    ui.style.height = ui.style.font.size.y;
    ui.flow_dir = vec2(-1, 0);

    // minimap widget
    const ui_minimap_extent = min(SCREEN_HEIGHT / 5.0, 256);
    const ui_minimap_bounds = vec4f(R.xy - ui_minimap_extent - 5, R.xy - 5);
    uiMinimap(frag_coord, ui_minimap_bounds);

    if (game.tool_allowed == tool_info ||
        game.tool_allowed == tool_pick ||
        game.tool_allowed == tool_heat ) {
        // info widget following mouse
        let ui_info_bounds = fragmentCoord(mouse.pos.xy + vec2i(8, -8)).xyxy + vec4f(0, 0, ui_minimap_extent, 11 * ui.style.height + ui.style.margin.y + ui.style.margin.w);
        uiInfo(frag_coord, ui_info_bounds);
    }
    if (game.tool_allowed == tool_info) {
        // selection widget anchored on right
        let ui_selection_bounds = ui_minimap_bounds - vec4(0, SCREEN_HEIGHT - ui_minimap_extent - 5 * 2, 0, ui_minimap_extent + 5);
        uiSelection(frag_coord, ui_selection_bounds);
    }
#if 1// visualize auto-exposure luminance histogram
    if (game.tool_allowed == tool_light)
    {
        const box_min = vec2f(5, 5);
        const box_max = vec2f(R.x - 5, 50);//vec2f(500, 100);
        const box_extent = box_max - box_min;
        const box_center = (box_max + box_min) / 2;

        const num_bins_oo = 1.0 / f32(EXPOSURE_HISTOGRAM_NUM_BINS);
        const num_pixels_oo = 1.0 / f32(SCREEN_WIDTH * SCREEN_HEIGHT);
        const log_num_pixels_oo = 1.0 / log2(f32(SCREEN_WIDTH * SCREEN_HEIGHT));

        let restore_style = canvas.style;

        exposureHistogramWidget(frag_coord, vec4(box_min, box_max));

#if 0
        canvas.style = restore_style;

        canvas.style.stroke_width = 0.0;
        canvas.style.glow_width = 0;
        canvas.style.feather = 2;

        {
            let smp_id = vec2i(wid.xy * vec2u(16,16) + vec2u(1,15));
            var pos_mean = fragmentCoord(smp_id);

            let hdr_color = passSampleLevelBilinearRepeat(CH_screenspace_distancefield_cells, pos_mean / R, 0).rgb;
            let bin_idx = exposureColorToBin(hdr_color, map.exposure.min_log, map.exposure.inverse_log_range);

#if 0
            let ldr_color = saturate(tonemapAGX(hdr_color, agx_look_default));
            canvas.style.fill = vec4f(1.0 - ldr_color, 0.9);
#else
            let v = log2(f32(map.exposure.last_histogram[bin_idx]) + M_EPSILON) * log_num_pixels_oo;
            canvas.style.fill = vec4f(heatPalette(v), 0.9);
#endif

            var text = createTextWriter(frag_coord, vec2f(1,0), vec2f(0,1));
            textMoveTo(&text, pos_mean);
            textWriteUInt(&text, typeface_small, bin_idx);

            canvasDrawSDF(text.SDF, 1);
        }

        canvas.style = restore_style;
#endif
    }
#endif
#endif

    // --- Blit all previous canvas operations on top of the image ---
    const canvas_blit_opacity = 1.0;
    col = canvasBlit(col, canvas_blit_opacity).rgb;

    // --- Final creen output ---
    // Convert from gamma-encoded to linear colour space
    //col = pow(col, vec3f(2.2));
    col = sRgbToLinear(col);
    // Output to screen (linear colour space)

    if (all(vec2i(id.xy) < vec2i(R))) {
        textureStore(screen, id.xy, vec4f(col, 1.));
    }
}




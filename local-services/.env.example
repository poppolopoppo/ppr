# Floating-tag policy: crawl4ai/searxng track :latest, no digest pins. Empty slot = latest.
# Headroom is the exception: pinned to the tested 0.37.x tag (Phase 1 posture).
CRAWL4AI_IMAGE=
SEARXNG_IMAGE=
VALKEY_IMAGE=
HEADROOM_IMAGE=ghcr.io/headroomlabs-ai/headroom:0.37.0

# Required secrets. Generate externally and install locally; never commit .env.
CRAWL4AI_API_TOKEN=
SECRET_KEY=
SEARXNG_SECRET=

# Non-secret Headroom proxy config (container is keyless by default).
HEADROOM_PROXY_URL=http://127.0.0.1:8787
HEADROOM_PORT=8787
HEADROOM_MCP_PORT=8788
HEADROOM_MODE=cache
HEADROOM_SAVINGS_PROFILE=coding
HEADROOM_KOMPRESS_BACKEND=auto
HEADROOM_UPSTREAM_ALLOWED_HOSTS=opencode.ai

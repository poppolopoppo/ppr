{
  "version": 12,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "description": "Default configuration using Ninja and vcpkg for dependencies (manifest mode). Uses single-config Ninja to avoid CMake 4.4 synthetic target genex leak into multi-config C++ module BMIs. Revisit once CMake fixes multi-config genex evaluation for synthetic targets.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "warnings": {
        "experimental": false
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_CACHE": "ON",
        "CPM_SOURCE_CACHE": "${sourceDir}/out/cpm_cache",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/build/${presetName}/vcpkg_installed"
      }
    },
    {
      "name": "developer",
      "description": "Developer mode with warnings as errors and sanitizers",
      "inherits": "default",
      "cacheVariables": {
        "PPR_ENABLE_DEVELOPER_MODE": "ON",
        "PPR_LOGGING_LEVEL": "DEBUG"
      }
    },
    {
      "name": "vcpkg",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-default",
      "description": "Base Windows configuration for MSVC and Clang.",
      "hidden": true,
      "inherits": "default",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "VS_SEGMENT_HEAP_ALLOWLIST": "app.game;engine.tests.core;engine.tests.app;"
      },
      "cacheVariables": {
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "$env{VSINSTALLDIR}Common7/IDE/CommonExtensions/Microsoft/CMake/cmake/Microsoft/SegmentHeap.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-msvc-toolchain",
      "description": "Native x64 MSVC tools from the activated VS 18 Insiders environment.",
      "hidden": true,
      "inherits": "windows-default",
      "environment": {
        "VCPKG_VISUAL_STUDIO_PATH": "$env{VSINSTALLDIR}"
      },
      "cacheVariables": {
        "PPR_REQUIRE_MSVC_TOOLCHAIN": "ON",
        "CMAKE_C_COMPILER": "$env{VCToolsInstallDir}bin/Hostx64/x64/cl.exe",
        "CMAKE_CXX_COMPILER": "$env{VCToolsInstallDir}bin/Hostx64/x64/cl.exe",
        "CMAKE_LINKER": "$env{VCToolsInstallDir}bin/Hostx64/x64/link.exe",
        "CMAKE_AR": "$env{VCToolsInstallDir}bin/Hostx64/x64/lib.exe"
      }
    },
    {
      "name": "unix-like-default",
      "description": "Base Linux configuration for GCC and Clang.",
      "hidden": true,
      "inherits": "vcpkg",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Darwin",
          "Linux"
        ]
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Linux"
          ]
        },
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
        }
      }
    },
    {
      "name": "msvc-dev",
      "displayName": "MSVC Developer",
      "description": "Build with MSVC and developer mode enabled.",
      "inherits": "windows-msvc-toolchain",
      "cacheVariables": {
        "PPR_ENABLE_DEVELOPER_MODE": "ON",
        "PPR_ENABLE_SANITIZER_ADDRESS": "ON",
        "PPR_LOGGING_LEVEL": "DEBUG"
      }
    },
    {
      "name": "msvc-dev-freetype",
      "displayName": "MSVC Developer (ImGui FreeType evaluation)",
      "description": "M4 evaluation preset: msvc-dev plus the opt-in imgui-freetype manifest feature and the PPR_IMGUI_FREETYPE wrapper. Reserved for the stb-vs-FreeType comparison; never a shipped default.",
      "inherits": "msvc-dev",
      "cacheVariables": {
        "PPR_IMGUI_FREETYPE": "ON",
        "VCPKG_MANIFEST_FEATURES": "imgui-freetype"
      }
    },
    {
      "name": "msvc-rel",
      "displayName": "MSVC Release",
      "description": "Target Windows with the msvc compiler, release build type",
      "inherits": "windows-msvc-toolchain",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "PPR_ENABLE_DEVELOPER_MODE": "OFF",
        "PPR_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "msvc-profile",
      "displayName": "MSVC Profile (Instrumented Release)",
      "description": "Instrumented release for profiling: same flags as msvc-rel (/O2 /Ob2 /GL /Gw, LTCG, NDEBUG, PDBSTRIPPED) plus PIX markers (USE_PIX) and EMPHASIS logging.",
      "inherits": "msvc-rel",
      "binaryDir": "${sourceDir}/out/build/msvc-profile",
      "cacheVariables": {
        "PPR_ENABLE_PROFILING": "ON",
        "PPR_LOGGING_LEVEL": "EMPHASIS"
      }
    },
    {
      "name": "clang-cl-dev",
      "displayName": "Clang-cl Developer",
      "description": "Target Windows with the clang-cl compiler, debug build type",
      "inherits": "windows-default",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "PPR_ENABLE_DEVELOPER_MODE": "ON",
        "PPR_LOGGING_LEVEL": "DEBUG"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "clang-cl-rel",
      "displayName": "Clang-cl Release",
      "description": "Release build with Clang/LLVM on Windows.",
      "inherits": "windows-default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "PPR_ENABLE_DEVELOPER_MODE": "OFF",
        "PPR_WARNINGS_AS_ERRORS": "ON"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "msvc-live",
      "displayName": "MSVC Live (Edit & Continue, Debug)",
      "description": "Ninja single-config Debug with /ZI (EditAndContinue) for VS2026 Open Folder Edit&Continue + IntelliSense. No ASAN, no optimizations, no ccache. VS generator cannot be used because import std requires Ninja.",
      "inherits": "windows-msvc-toolchain",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PPR_ENABLE_DEVELOPER_MODE": "OFF",
        "PPR_WARNINGS_AS_ERRORS": "ON",
        "PPR_ENABLE_SANITIZER_ADDRESS": "OFF",
        "PPR_ENABLE_SANITIZER_UNDEFINED": "OFF",
        "ENABLE_CACHE": "OFF",
        "PPR_RELEASE_PERF_FLAGS": "OFF",
        "PPR_EDIT_AND_CONTINUE": "ON",
        "PPR_LOGGING_LEVEL": "DEBUG"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-msvc-x64"
        }
      }
    },
    {
      "name": "gcc-dev",
      "displayName": "GCC Developer **DO NOT WORK WITH MODULES**",
      "hidden": true,
      "description": "Target Unix-like OS with the gcc compiler",
      "inherits": "unix-like-default",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "PPR_ENABLE_DEVELOPER_MODE": "ON",
        "PPR_LOGGING_LEVEL": "DEBUG"
      }
    },
    {
      "name": "gcc-rel",
      "displayName": "GCC Release **DO NOT WORK WITH MODULES**",
      "hidden": true,
      "description": "Release build with GCC.",
      "inherits": "unix-like-default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "PPR_ENABLE_DEVELOPER_MODE": "OFF",
        "PPR_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "clang-dev",
      "displayName": "Clang Developer",
      "description": "Debug build with Clang",
      "inherits": "unix-like-default",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux-libcxx",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "PPR_ENABLE_DEVELOPER_MODE": "ON",
        "PPR_LOGGING_LEVEL": "DEBUG"
      }
    },
    {
      "name": "clang-rel",
      "displayName": "Clang Release",
      "description": "Release build with Clang",
      "inherits": "unix-like-default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux-libcxx",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "PPR_ENABLE_DEVELOPER_MODE": "OFF",
        "PPR_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-build",
      "description": "Platform gate for build presets on Windows hosts.",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "unix-like-build",
      "description": "Platform gate for build presets on Darwin and Linux hosts.",
      "hidden": true,
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Darwin",
          "Linux"
        ]
      }
    },
    {
      "name": "msvc-dev",
      "inherits": "windows-build",
      "displayName": "MSVC Developer Build",
      "description": "Build the msvc-dev tree. Add --target to narrow the build to one target.",
      "configurePreset": "msvc-dev"
    },
    {
      "name": "msvc-live",
      "inherits": "windows-build",
      "displayName": "MSVC Live Build",
      "description": "Build the msvc-live Edit & Continue tree.",
      "configurePreset": "msvc-live"
    },
    {
      "name": "msvc-rel",
      "inherits": "windows-build",
      "displayName": "MSVC Release Build",
      "description": "Build the msvc-rel tree.",
      "configurePreset": "msvc-rel"
    },
    {
      "name": "msvc-profile",
      "inherits": "windows-build",
      "displayName": "MSVC Profile Build",
      "description": "Build the instrumented msvc-profile tree.",
      "configurePreset": "msvc-profile"
    },
    {
      "name": "clang-cl-dev",
      "inherits": "windows-build",
      "displayName": "Clang-cl Developer Build",
      "description": "Build the clang-cl-dev tree.",
      "configurePreset": "clang-cl-dev"
    },
    {
      "name": "clang-cl-rel",
      "inherits": "windows-build",
      "displayName": "Clang-cl Release Build",
      "description": "Build the clang-cl-rel tree.",
      "configurePreset": "clang-cl-rel"
    },
    {
      "name": "clang-dev",
      "inherits": "unix-like-build",
      "displayName": "Clang Developer Build",
      "description": "Build the clang-dev tree. Add --target to narrow the build to one target.",
      "configurePreset": "clang-dev"
    },
    {
      "name": "clang-rel",
      "inherits": "unix-like-build",
      "displayName": "Clang Release Build",
      "description": "Build the clang-rel tree.",
      "configurePreset": "clang-rel"
    },
    {
      "name": "run-game-msvc-dev",
      "inherits": "windows-build",
      "displayName": "Run app.game (MSVC Developer)",
      "description": "Build and run app.game from its output directory. Game arguments require invoking the executable directly.",
      "configurePreset": "msvc-dev",
      "targets": [
        "run-app-game"
      ]
    },
    {
      "name": "run-game-msvc-profile",
      "inherits": "windows-build",
      "displayName": "Run app.game (MSVC Profile)",
      "description": "Build and run the instrumented app.game from its output directory.",
      "configurePreset": "msvc-profile",
      "targets": [
        "run-app-game"
      ]
    },
    {
      "name": "run-game-msvc-rel",
      "inherits": "windows-build",
      "displayName": "Run app.game (MSVC Release)",
      "description": "Build and run the release app.game from its output directory.",
      "configurePreset": "msvc-rel",
      "targets": [
        "run-app-game"
      ]
    },
    {
      "name": "run-game-clang-dev",
      "inherits": "unix-like-build",
      "displayName": "Run app.game (Clang Developer)",
      "description": "Build and run app.game from its output directory. Game arguments require invoking the executable directly.",
      "configurePreset": "clang-dev",
      "targets": [
        "run-app-game"
      ],
      "environment": {
        "VK_LOADER_DISABLE_DYNAMIC_LIBRARY_UNLOADING": "1",
        "LSAN_OPTIONS": "$penv{LSAN_OPTIONS}:suppressions=${sourceDir}/cmake/sanitizers/nvidia.lsan.supp"
      }
    },
    {
      "name": "run-game-clang-rel",
      "inherits": "unix-like-build",
      "displayName": "Run app.game (Clang Release)",
      "description": "Build and run the release app.game from its output directory.",
      "configurePreset": "clang-rel",
      "targets": [
        "run-app-game"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-test",
      "description": "Platform gate for test presets on Windows hosts.",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "unix-like-test",
      "description": "Platform gate for test presets on Darwin and Linux hosts.",
      "hidden": true,
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Darwin",
          "Linux"
        ]
      }
    },
    {
      "name": "msvc-dev",
      "inherits": "windows-test",
      "displayName": "MSVC Developer Tests",
      "description": "Routine suite; excludes the opt-in GPU validation entries.",
      "configurePreset": "msvc-dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4,
        "noTestsAction": "error"
      },
      "filter": {
        "exclude": {
          "label": "gpu_validation"
        }
      }
    },
    {
      "name": "msvc-dev-gpu",
      "inherits": "windows-test",
      "displayName": "MSVC Developer GPU Validation",
      "description": "Opt-in GPU validation entries; runs serially and exclusively.",
      "configurePreset": "msvc-dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "gpu_validation"
        }
      }
    },
    {
      "name": "msvc-live",
      "inherits": "windows-test",
      "displayName": "MSVC Live Tests",
      "description": "Routine suite in the msvc-live Edit & Continue tree.",
      "configurePreset": "msvc-live",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4,
        "noTestsAction": "error"
      },
      "filter": {
        "exclude": {
          "label": "gpu_validation"
        }
      }
    },
    {
      "name": "clang-dev",
      "inherits": "unix-like-test",
      "displayName": "Clang Developer Tests",
      "description": "Routine suite; excludes the opt-in GPU validation entries.",
      "configurePreset": "clang-dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4,
        "noTestsAction": "error"
      },
      "filter": {
        "exclude": {
          "label": "gpu_validation"
        }
      }
    },
    {
      "name": "clang-dev-gpu",
      "inherits": "unix-like-test",
      "displayName": "Clang Developer GPU Validation",
      "description": "Opt-in GPU validation entries; runs serially and exclusively.",
      "configurePreset": "clang-dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "gpu_validation"
        }
      }
    }
  ]
}

{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "description": "Default configuration using Ninja and vcpkg for dependencies (manifest mode). Uses single-config Ninja to avoid CMake 4.4 synthetic target genex leak into multi-config C++ module BMIs. Revisit once CMake fixes multi-config genex evaluation for synthetic targets.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_CACHE": "ON",
        "CPM_SOURCE_CACHE": "${sourceDir}/out/cpm_cache",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/build/${presetName}/vcpkg_installed"
      }
    },
    {
      "name": "developer",
      "description": "Developer mode with warnings as errors and sanitizers",
      "inherits": "default",
      "cacheVariables": {
        "PPR_ENABLE_DEVELOPER_MODE": "ON"
      }
    },
    {
      "name": "vcpkg",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-default",
      "description": "Base Windows configuration for MSVC and Clang.",
      "hidden": true,
      "inherits": "default",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "VS_SEGMENT_HEAP_ALLOWLIST": "VideoGameApp;EngineTests;"
      },
      "cacheVariables": {
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "$env{VSINSTALLDIR}Common7/IDE/CommonExtensions/Microsoft/CMake/cmake/Microsoft/SegmentHeap.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "unix-like-default",
      "description": "Base Linux configuration for GCC and Clang.",
      "hidden": true,
      "inherits": "vcpkg",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Darwin",
          "Linux"
        ]
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Linux" ]
        },
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
        }
      }
    },
    {
      "name": "msvc-dev",
      "displayName": "MSVC Developer",
      "description": "Build with MSVC and developer mode enabled.",
      "inherits": "windows-default",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "PPR_ENABLE_DEVELOPER_MODE": "ON"
      }
    },
    {
      "name": "msvc-rel",
      "displayName": "MSVC Release",
      "description": "Target Windows with the msvc compiler, release build type",
      "inherits": "windows-default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "PPR_ENABLE_DEVELOPER_MODE": "OFF"
      }
    },
    {
      "name": "clang-cl-dev",
      "displayName": "Clang-cl Developer",
      "description": "Target Windows with the clang-cl compiler, debug build type",
      "inherits": "windows-default",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "PPR_ENABLE_DEVELOPER_MODE": "ON"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "clang-cl-rel",
      "displayName": "Clang-cl Release",
      "description": "Release build with Clang/LLVM on Windows.",
      "inherits": "windows-default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "PPR_ENABLE_DEVELOPER_MODE": "OFF"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "msvc-live",
      "displayName": "MSVC Live (Edit & Continue, Debug)",
      "description": "Ninja single-config Debug with /ZI (EditAndContinue) for VS2026 Open Folder Edit&Continue + IntelliSense. No ASAN, no optimizations, no ccache. VS generator cannot be used because import std requires Ninja.",
      "inherits": "windows-default",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PPR_ENABLE_DEVELOPER_MODE": "OFF",
        "PPR_ENABLE_SANITIZER_ADDRESS": "OFF",
        "PPR_ENABLE_SANITIZER_UNDEFINED": "OFF",
        "ENABLE_CACHE": "OFF",
        "PPR_RELEASE_PERF_FLAGS": "OFF",
        "PPR_EDIT_AND_CONTINUE": "ON"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-msvc-x64"
        }
      }
    },
    {
      "name": "gcc-dev",
      "displayName": "GCC Developer **DO NOT WORK WITH MODULES**",
      "hidden": true,
      "description": "Target Unix-like OS with the gcc compiler",
      "inherits": "unix-like-default",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "PPR_ENABLE_DEVELOPER_MODE": "ON"
      }
    },
    {
      "name": "gcc-rel",
      "displayName": "GCC Release **DO NOT WORK WITH MODULES**",
      "hidden": true,
      "description": "Release build with GCC.",
      "inherits": "unix-like-default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "PPR_ENABLE_DEVELOPER_MODE": "OFF"
      }
    },
    {
      "name": "clang-dev",
      "displayName": "Clang Developer",
      "description": "Debug build with Clang",
      "inherits": "unix-like-default",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "PPR_ENABLE_DEVELOPER_MODE": "ON"
      }
    },
    {
      "name": "clang-rel",
      "displayName": "Clang Release",
      "description": "Release build with Clang",
      "inherits": "unix-like-default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "PPR_ENABLE_DEVELOPER_MODE": "OFF"
      }
    }
  ]
}
